]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">MonstreOutils</string><ProtectedString name="Source"><![CDATA[--[[
	MonstreOutils (ModuleScript, ServerStorage) : essais depuis la barre de commande (ou par Claude via le serveur MCP de
	Studio). Pendant un test (F5), la barre de commande s'exécute côté serveur :
		local O = require(game.ServerStorage.MonstreOutils)
		O.victimeTest()                 -- un survivant d'essai (copie du StarterCharacter) devant le monstre
		O.miseAMort("frenesie")         -- mise à mort sur la victime la plus proche (ou O.miseAMort("trainee", victime))
		O.geste("roar")                 -- hurlement ; "sniff" : flairer ; "attack" : attaque
		O.pause(true)                   -- arrête l'IA (false : la relance)
		print(O.liste())                -- mises à mort et clips disponibles
		print(O.verifier())             -- contrôle de l'installation (fonctionne aussi en mode édition)
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")

local O = {}

local function monstre()
	for _, m in ipairs(CollectionService:GetTagged("Monstre")) do
		return m
	end
	return nil
end

local function api()
	local s = ServerScriptService:FindFirstChild("MonstreServeur")
	return s and s:FindFirstChild("MonstreAPI")
end

local function plusProche(m)
	local hrp = m and m:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local best, dmin = nil, math.huge
	local cands = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(cands, p.Character)
		end
	end
	for _, v in ipairs(CollectionService:GetTagged("Survivant")) do
		table.insert(cands, v)
	end
	for _, c in ipairs(cands) do
		local h = c:FindFirstChildOfClass("Humanoid")
		local r = c:FindFirstChild("HumanoidRootPart")
		if h and r and h.Health > 0 and not c:GetAttribute("MA_EnMiseAMort") then
			local d = (r.Position - hrp.Position).Magnitude
			if d < dmin then
				best, dmin = c, d
			end
		end
	end
	return best
end

-- survivant d'essai : copie du StarterCharacter, étiquetée « Survivant », 6 studs devant le monstre
function O.victimeTest(position)
	local modeleSrc = StarterPlayer:FindFirstChild("StarterCharacter")
	if not modeleSrc then
		return nil, "pas de StarterPlayer.StarterCharacter (installez d'abord le survivant)"
	end
	local m = monstre()
	local c = modeleSrc:Clone()
	c.Name = "Victime_Essai"
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BaseScript") then
			d:Destroy()
		end
	end
	local pos, regard = position, Vector3.new(0, 0, 1)
	if not pos and m and m:FindFirstChild("HumanoidRootPart") then
		local cf = m.HumanoidRootPart.CFrame
		local avant = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z).Unit
		pos = cf.Position + avant * 6 - Vector3.new(0, 4.128, 0) -- HumanoidRootPart du survivant 3 studs au-dessus du sol
		regard = -avant
	end
	pos = pos or Vector3.new(0, 3, 0)
	c:PivotTo(CFrame.lookAt(pos, pos + regard))
	CollectionService:AddTag(c, "Survivant")
	c.Parent = workspace
	return c
end

function O.miseAMort(cle, victime)
	local a = api()
	if not a then
		return false, "MonstreServeur ne tourne pas (lancez le test avec F5)"
	end
	local m = monstre()
	victime = victime or plusProche(m)
	if not victime then
		return false, "aucune victime : O.victimeTest() en crée une"
	end
	task.spawn(function()
		a:Invoke("miseAMort", m, victime, cle)
	end)
	return true
end

function O.geste(cle)
	local a = api()
	if not a then
		return false, "MonstreServeur ne tourne pas"
	end
	return a:Invoke("geste", monstre(), cle)
end

function O.pause(actif)
	local a = api()
	if not a then
		return false, "MonstreServeur ne tourne pas"
	end
	return a:Invoke("pause", monstre(), actif)
end

function O.etat()
	local a = api()
	if not a then
		return nil
	end
	return a:Invoke("etat", monstre())
end

function O.liste()
	local dossier = ReplicatedStorage:FindFirstChild("Monstre")
	local d = dossier and require(dossier.MonstreDonnees)
	if not d then
		return "MonstreDonnees introuvable"
	end
	local lignes = { "Mises à mort :" }
	for _, s in ipairs(d.sequences) do
		local ph = {}
		for _, p in ipairs(s.phases) do
			table.insert(ph, p.clip)
		end
		table.insert(lignes, string.format("  %-16s %s (%s) -> %s", s.key, s.label, table.concat(ph, ", "), s.fin))
	end
	local cl = {}
	for k, _ in pairs(d.monstre) do
		table.insert(cl, k)
	end
	table.sort(cl)
	table.insert(lignes, "Clips du monstre : " .. table.concat(cl, ", "))
	return table.concat(lignes, "\n")
end

function O.verifier()
	local lignes = {}
	local okTout = true
	local function ligne(ok, texte)
		okTout = okTout and ok
		table.insert(lignes, (ok and "OK   " or "ERR  ") .. texte)
	end
	local m = monstre()
	ligne(m ~= nil, "modèle étiqueté « Monstre » : " .. (m and m:GetFullName() or "absent"))
	if m then
		local n = 0
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("Motor6D") then
				n += 1
			end
		end
		ligne(n == 38, string.format("%d Motor6D (38 attendus)", n))
		local h = m:FindFirstChildOfClass("Humanoid")
		ligne(h ~= nil and math.abs(h.HipHeight - 5.928) < 0.01, "Humanoid, HipHeight " .. (h and string.format("%.3f", h.HipHeight) or "?"))
		ligne(m:FindFirstChild("VictimeAncrePart") ~= nil, "pièce VictimeAncrePart")
		ligne(m:FindFirstChild("Lueur") ~= nil, "lueur de la gueule")
	end
	local dossier = ReplicatedStorage:FindFirstChild("Monstre")
	ligne(dossier ~= nil, "ReplicatedStorage.Monstre")
	if dossier then
		for _, nom in ipairs({ "MonstreAnim", "MonstreConfig", "MonstreDonnees" }) do
			ligne(dossier:FindFirstChild(nom) ~= nil, nom)
		end
		local e = dossier:FindFirstChild("Effets")
		local n = e and #e:GetChildren() or 0
		ligne(n >= 6, string.format("gabarits de sang : %d (SANG_Flaque, SANG_Eclaboussure_1..3, SANG_Trainee, SANG_Ecran, SANG_Goutte)", n))
	end
	ligne(ServerScriptService:FindFirstChild("MonstreServeur") ~= nil, "ServerScriptService.MonstreServeur")
	local sps = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
	ligne(sps ~= nil and sps:FindFirstChild("MonstreClient") ~= nil, "StarterPlayerScripts.MonstreClient")
	table.insert(lignes, (StarterPlayer:FindFirstChild("StarterCharacter") and "OK   " or "info ")
		.. "StarterCharacter (survivant) : les victimes ne sont animées que si elles ont son rig")
	local cfg = dossier and dossier:FindFirstChild("MonstreConfig") and require(dossier.MonstreConfig)
	if cfg then
		local manquants = 0
		for k, v in pairs(cfg.SONS) do
			if k ~= "volume" and v == "" then
				manquants += 1
			end
		end
		table.insert(lignes, string.format("info sons sans identifiant : %d (voir monstre/roblox/sons/LISEZMOI.md)", manquants))
	end
	return table.concat(lignes, "\n"), okTout
end

return O
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">MonstreServeur</string><ProtectedString name="Source"><![CDATA[--[[
	MonstreServeur (Script, ServerScriptService) : intelligence du monstre et déroulement des mises à mort.

	Le serveur décide (patrouille, poursuite, choix et déroulement des mises à mort, cadavre, infection) et publie l'état
	dans des attributs du modèle du monstre ; chaque client anime le monstre et la victime à partir de ces attributs
	(MonstreClient), ce qui garde les animations synchronisées sans rien publier sur Roblox.
		MA_Action / MA_ActionDebut : geste en cours (hurlement, flairer, attaque) et heure de début (horloge du serveur)
		MA_Sequence : mise à mort en cours (clé de MonstreDonnees.sequences) ; MA_Phase / MA_PhaseDebut : clip en cours
		MA_Graine : graine du hasard partagé (éclaboussures) ; ObjectValue MA_Victime : la victime
	Les victimes sont les personnages des joueurs et les modèles étiquetés CONFIG.ETIQUETTE_VICTIME (essais).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local dossier = ReplicatedStorage:WaitForChild("Monstre")
local CONFIG = require(dossier:WaitForChild("MonstreConfig"))
local DATA = require(dossier:WaitForChild("MonstreDonnees"))
local MA = require(dossier:WaitForChild("MonstreAnim")).init(DATA)

local SEQ = {}
for _, s in ipairs(DATA.sequences) do
	SEQ[s.key] = s
end

local AVANCE = 0.12 -- les clients commencent une phase un peu après l'annonce (latence)
local HRP_Y = DATA.rig.hrp.center[2] -- hauteur du centre du HumanoidRootPart au-dessus du sol

local function maintenant()
	return workspace:GetServerTimeNow()
end

local function log(...)
	if CONFIG.DEBUG then
		print("[Monstre]", ...)
	end
end

local function plat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function attendreJusqua(t)
	while maintenant() < t do
		task.wait(math.min(0.1, math.max(t - maintenant(), 0.01)))
	end
end

------------------------------------------------------------------------------------------------------------
-- victimes
------------------------------------------------------------------------------------------------------------
local function humanoideVivant(modele)
	local h = modele and modele:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0 and modele:FindFirstChild("HumanoidRootPart") and h or nil
end

local function victimesPossibles()
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		if c and humanoideVivant(c) and not c:GetAttribute("MA_EnMiseAMort") and not c:GetAttribute("MA_Ignore") then
			table.insert(out, c)
		end
	end
	for _, m in ipairs(CollectionService:GetTagged(CONFIG.ETIQUETTE_VICTIME)) do
		if m:IsA("Model") and humanoideVivant(m) and not m:GetAttribute("MA_EnMiseAMort") then
			table.insert(out, m)
		end
	end
	return out
end

------------------------------------------------------------------------------------------------------------
-- le monstre
------------------------------------------------------------------------------------------------------------
local Monstre = {}
Monstre.__index = Monstre
local MONSTRES = {}

function Monstre.new(modele)
	local self = setmetatable({}, Monstre)
	self.modele = modele
	self.hum = modele:FindFirstChildOfClass("Humanoid")
	self.hrp = modele:FindFirstChild("HumanoidRootPart")
	self.ancrePart = modele:FindFirstChild("VictimeAncrePart", true)
	self.ancreMoteur = modele:FindFirstChild("VictimeAncre", true)
	assert(self.hum and self.hrp and self.ancrePart and self.ancreMoteur, "modèle du monstre incomplet : relancez l'installateur")
	self.depart = self.hrp.Position
	self.etat = "patrouille"
	self.occupe = false
	self.reposJusqua = 0
	self.derniereVue = 0
	self.dernierHurlement = -100
	self.victimeVal = modele:FindFirstChild("MA_Victime") or Instance.new("ObjectValue")
	self.victimeVal.Name = "MA_Victime"
	self.victimeVal.Value = nil
	self.victimeVal.Parent = modele
	for nom, v in pairs({ MA_Action = "", MA_ActionDebut = 0, MA_Sequence = "", MA_Phase = "", MA_PhaseDebut = 0, MA_Graine = 0 }) do
		modele:SetAttribute(nom, v)
	end
	self.hum.MaxHealth = CONFIG.VIE
	self.hum.Health = CONFIG.VIE
	self.hum.WalkSpeed = CONFIG.VITESSE.marche
	self.hrp.Anchored = false
	pcall(function()
		self.hrp:SetNetworkOwner(nil)
	end)
	self.params = RaycastParams.new()
	self.params.FilterType = Enum.RaycastFilterType.Exclude
	self.params.FilterDescendantsInstances = { modele }
	return self
end

-- geste (clip non bouclé du monstre) : attributs pour les clients, attente de la fin
function Monstre:geste(cle, bloquant)
	local c = DATA.monstre[cle]
	if not c then
		return
	end
	local debut = maintenant() + AVANCE
	self.modele:SetAttribute("MA_ActionDebut", debut)
	self.modele:SetAttribute("MA_Action", cle)
	if bloquant ~= false then
		self.hum:MoveTo(self.hrp.Position)
		attendreJusqua(debut + c.length)
		if self.modele:GetAttribute("MA_Action") == cle then
			self.modele:SetAttribute("MA_Action", "")
		end
	end
end

function Monstre:yeux()
	return self.hrp.Position + Vector3.new(0, 2.8, 0)
end

function Monstre:voit(c)
	local root = c:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local o = self:yeux()
	local d = root.Position - o
	if d.Magnitude > CONFIG.DETECTION.vue then
		return false
	end
	local f = plat(d)
	if f.Magnitude > 2 then
		local cosA = self.hrp.CFrame.LookVector:Dot(f.Unit)
		if cosA < math.cos(math.rad(CONFIG.DETECTION.angle_vue / 2)) then
			return false
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.modele, c }
	return workspace:Raycast(o, d, params) == nil
end

function Monstre:entend(c)
	local root = c:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local dist = (root.Position - self.hrp.Position).Magnitude
	return dist < CONFIG.DETECTION.ouie and plat(root.AssemblyLinearVelocity).Magnitude > 10
end

function Monstre:chercherCible()
	local meilleure, dmin = nil, math.huge
	for _, c in ipairs(victimesPossibles()) do
		local root = c.HumanoidRootPart
		local dist = (root.Position - self.hrp.Position).Magnitude
		if dist < dmin and (self:voit(c) or self:entend(c) or (c == self.cible and dist < 12)) then
			meilleure, dmin = c, dist
		end
	end
	return meilleure, dmin
end

-- se déplace vers pos (chemin recalculé quand le but bouge)
function Monstre:allerVers(pos, vitesse)
	self.hum.WalkSpeed = vitesse
	local t = maintenant()
	if not self.chemin or t - self.cheminT > 0.8 or (pos - self.cheminBut).Magnitude > 4 then
		self.cheminT, self.cheminBut = t, pos
		local path = PathfindingService:CreatePath({ AgentRadius = 2.4, AgentHeight = 8, AgentCanJump = true,
			WaypointSpacing = 4 })
		local ok = pcall(function()
			path:ComputeAsync(self.hrp.Position, pos)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			self.chemin = path:GetWaypoints()
			self.wi = math.min(2, #self.chemin)
		else
			self.chemin = { { Position = pos, Action = Enum.PathWaypointAction.Walk } }
			self.wi = 1
		end
	end
	local wp = self.chemin[self.wi]
	while wp and plat(wp.Position - self.hrp.Position).Magnitude < 3 and self.wi < #self.chemin do
		self.wi += 1
		wp = self.chemin[self.wi]
	end
	if wp then
		if wp.Action == Enum.PathWaypointAction.Jump then
			self.hum.Jump = true
		end
		self.hum:MoveTo(wp.Position)
	end
end

function Monstre:arret()
	self.chemin = nil
	self.hum:MoveTo(self.hrp.Position)
end

function Monstre:pointPatrouille()
	local tags = CollectionService:GetTagged(CONFIG.PATROUILLE.etiquette)
	if #tags > 0 then
		local p = tags[math.random(1, #tags)]
		if p:IsA("BasePart") then
			return p.Position
		end
	end
	local a = math.random() * math.pi * 2
	local r = CONFIG.PATROUILLE.rayon * (0.3 + 0.7 * math.random())
	return self.depart + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

function Monstre:choisirMiseAMort()
	local total, liste = 0, {}
	for cle, poids in pairs(CONFIG.MISES_A_MORT) do
		if SEQ[cle] and poids > 0 and cle ~= self.derniereMiseAMort then
			total += poids
			table.insert(liste, { cle, poids })
		end
	end
	if total <= 0 then
		return self.derniereMiseAMort
	end
	table.sort(liste, function(a, b)
		return a[1] < b[1]
	end)
	local r = math.random() * total
	for _, e in ipairs(liste) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return liste[#liste][1]
end

function Monstre:penser()
	local cible, dist = self:chercherCible()
	local t = maintenant()
	if cible then
		if cible ~= self.cible then
			self.cible = cible
			if self.etat ~= "chasse" and CONFIG.DETECTION.hurle_a_la_vue and t - self.dernierHurlement > 12 then
				self.dernierHurlement = t
				self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + plat(cible.HumanoidRootPart.Position - self.hrp.Position))
				self:geste("roar")
			end
		end
		self.etat = "chasse"
		self.derniereVue = t
		self.dernierePosition = cible.HumanoidRootPart.Position
		if dist <= CONFIG.PORTEE_ATTAQUE and maintenant() > self.reposJusqua then
			self:miseAMort(cible, self:choisirMiseAMort())
			return
		end
		self:allerVers(cible.HumanoidRootPart.Position, CONFIG.VITESSE.course)
		return
	end
	if self.etat == "chasse" then
		if t - self.derniereVue < CONFIG.DETECTION.oubli and self.dernierePosition then
			self:allerVers(self.dernierePosition, CONFIG.VITESSE.course)
			if plat(self.dernierePosition - self.hrp.Position).Magnitude < 4 then
				self.etat = "recherche"
			end
			return
		end
		self.etat = "recherche"
	end
	if self.etat == "recherche" then
		self.cible = nil
		self:arret()
		self:geste("sniff")
		self.etat = "patrouille"
		self.but = nil
		return
	end
	-- patrouille
	if not self.but or plat(self.but - self.hrp.Position).Magnitude < 4 or t > (self.butLimite or 0) then
		if self.but then
			self:arret()
			if math.random() < CONFIG.PATROUILLE.flairer then
				self:geste("sniff")
			else
				task.wait(CONFIG.PATROUILLE.pause_min + math.random() * (CONFIG.PATROUILLE.pause_max - CONFIG.PATROUILLE.pause_min))
			end
		end
		self.but = self:pointPatrouille()
		self.butLimite = t + 25
	end
	self:allerVers(self.but, CONFIG.VITESSE.marche)
end

function Monstre:boucle()
	while self.modele.Parent do
		if not self.occupe and not self.enPause then
			local ok, err = pcall(self.penser, self)
			if not ok then
				warn("[Monstre] " .. tostring(err))
				task.wait(1)
			end
		end
		task.wait(0.15)
	end
end

------------------------------------------------------------------------------------------------------------
-- mises à mort
------------------------------------------------------------------------------------------------------------

-- place le monstre face à la victime, la victime exactement sur l'ancre (position de repos de VictimeAncre)
function Monstre:placer(victime)
	local vroot = victime.HumanoidRootPart
	local d = plat(vroot.Position - self.hrp.Position)
	if d.Magnitude < 0.1 then
		d = plat(self.hrp.CFrame.LookVector)
	end
	d = d.Unit
	local rel = self.ancreMoteur.C0 * self.ancreMoteur.C1:Inverse() -- ancre au repos, repère du HumanoidRootPart
	local cible = CFrame.lookAt(Vector3.zero, d)
	local P = vroot.Position - cible:VectorToWorldSpace(rel.Position)
	local cf = CFrame.lookAt(P, P + d)
	self.hrp.Anchored = true
	local depart = self.hrp.CFrame
	for i = 1, 6 do
		self.hrp.CFrame = depart:Lerp(cf, i / 6)
		task.wait()
	end
	self.hrp.CFrame = cf
	return cf * rel
end

local function sauverEtat(victime)
	local st = { parties = {}, hum = {} }
	local h = victime:FindFirstChildOfClass("Humanoid")
	st.hum = { PlatformStand = h.PlatformStand, AutoRotate = h.AutoRotate, BreakJointsOnDeath = h.BreakJointsOnDeath }
	for _, p in ipairs(victime:GetDescendants()) do
		if p:IsA("BasePart") then
			st.parties[p] = { CanCollide = p.CanCollide, Massless = p.Massless, Anchored = p.Anchored }
			p.CanCollide = false
			p.Massless = true
			p.Anchored = false
		end
	end
	h.PlatformStand = true
	h.AutoRotate = false
	h.BreakJointsOnDeath = false
	return st
end

local function restaurerEtat(victime, st)
	if not st then
		return
	end
	for p, v in pairs(st.parties) do
		if p.Parent then
			p.CanCollide = v.CanCollide
			p.Massless = v.Massless
			p.Anchored = v.Anchored
		end
	end
	local h = victime:FindFirstChildOfClass("Humanoid")
	if h then
		h.PlatformStand = st.hum.PlatformStand
		h.AutoRotate = st.hum.AutoRotate
		h.BreakJointsOnDeath = st.hum.BreakJointsOnDeath
	end
end

local function joueurDe(victime)
	return Players:GetPlayerFromCharacter(victime)
end

-- destination d'une traînée : partie étiquetée la plus proche, sinon loin des autres joueurs
function Monstre:destination(etiquette, victime)
	local pos = self.hrp.Position
	local best, dmin = nil, CONFIG.TRAINER.distance_max
	for _, p in ipairs(CollectionService:GetTagged(etiquette)) do
		if p:IsA("BasePart") then
			local d = (p.Position - pos).Magnitude
			if d < dmin and d > 6 then
				best, dmin = p.Position, d
			end
		end
	end
	if best then
		return best
	end
	local fuite = Vector3.zero
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl.Character
		if c and c ~= victime and c:FindFirstChild("HumanoidRootPart") then
			local d = plat(pos - c.HumanoidRootPart.Position)
			if d.Magnitude > 0.1 then
				fuite += d.Unit / math.max(d.Magnitude, 4)
			end
		end
	end
	if fuite.Magnitude < 1e-3 then
		fuite = -plat(self.hrp.CFrame.LookVector) -- dans le dos du monstre (son corps regarde par là en traînant)
	end
	return pos + fuite.Unit * CONFIG.TRAINER.distance_sans_cible
end

-- traîne la victime (le HumanoidRootPart, ancré, recule : le corps est tourné de 180 degrés dans le clip)
function Monstre:trainer(victime, but, vitesse, distanceMax)
	local pos = self.hrp.Position
	local points = { but }
	local path = PathfindingService:CreatePath({ AgentRadius = 2.4, AgentHeight = 8, AgentCanJump = false, WaypointSpacing = 4 })
	local ok = pcall(function()
		path:ComputeAsync(pos, but)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		points = {}
		for i, wp in ipairs(path:GetWaypoints()) do
			if i > 1 then
				table.insert(points, wp.Position)
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.modele, victime }
	local dir = -plat(self.hrp.CFrame.LookVector).Unit
	local parcouru, i = 0, 1
	while parcouru < distanceMax and points[i] and victime.Parent do
		local dt = math.min(task.wait(), 0.1)
		local cur = self.hrp.Position
		local vise = plat(points[i] - cur)
		if vise.Magnitude < 1.5 then
			i += 1
			continue
		end
		-- tourne progressivement vers la direction du chemin (au plus 120 degrés par seconde)
		local want = vise.Unit
		local ang = math.acos(math.clamp(dir:Dot(want), -1, 1))
		local maxA = math.rad(120) * dt
		if ang > maxA then
			local axe = dir:Cross(want).Y >= 0 and 1 or -1
			dir = (CFrame.Angles(0, axe * maxA, 0) * CFrame.new(dir)).Position.Unit
		else
			dir = want
		end
		local pas = math.min(vitesse * dt, vise.Magnitude)
		local np = cur + dir * pas
		local sol = workspace:Raycast(np + Vector3.new(0, 4, 0), Vector3.new(0, -HRP_Y - 10, 0), params)
		if sol then
			np = Vector3.new(np.X, sol.Position.Y + HRP_Y, np.Z)
		end
		local mur = workspace:Raycast(cur + Vector3.new(0, -HRP_Y + 1.5, 0), dir * 3, params)
		if mur and mur.Instance.CanCollide then
			break
		end
		self.hrp.CFrame = CFrame.lookAt(np, np - dir)
		parcouru += pas
	end
	return parcouru
end

-- cadavre posé : copies ancrées des parties visibles de la victime, à la pose finale de la mise à mort
local function creerCadavre(monstre, victime, cle, t)
	local ancreCF = MA.ancre(monstre.modele, cle, t)
	if not ancreCF then
		return nil
	end
	local pose = MA.pose("victime", cle, t)
	local cfs = MA.cinematique(victime, "victime", pose, ancreCF)
	-- parties soudées (tenue, anatomie) : même décalage que sur le serveur par rapport à leur pièce du rig
	local voisins = {}
	local function lier(a, b)
		if a and b then
			voisins[a] = voisins[a] or {}
			voisins[b] = voisins[b] or {}
			table.insert(voisins[a], b)
			table.insert(voisins[b], a)
		end
	end
	for _, d in ipairs(victime:GetDescendants()) do
		if d:IsA("WeldConstraint") or (d:IsA("JointInstance") and not d:IsA("Motor6D")) then
			lier(d.Part0, d.Part1)
		end
	end
	local rigParts = {} -- pièces reliées par des Motor6D (cinématique directe) et la racine
	for _, d in ipairs(victime:GetDescendants()) do
		if d:IsA("Motor6D") then
			for _, x in ipairs({ d.Part0, d.Part1 }) do
				if x and cfs[x] then
					rigParts[x] = true
				end
			end
		elseif d.Name == "HumanoidRootPart" and d:IsA("BasePart") and cfs[d] then
			rigParts[d] = true
		end
	end
	local finale = {}
	for p, _ in pairs(rigParts) do
		finale[p] = cfs[p]
	end
	-- parcours en largeur depuis les pièces du rig à travers les soudures
	local file = {}
	for p, _ in pairs(rigParts) do
		table.insert(file, p)
	end
	local k = 1
	while file[k] do
		local a = file[k]
		k += 1
		for _, b in ipairs(voisins[a] or {}) do
			if not finale[b] then
				finale[b] = finale[a] * a.CFrame:ToObjectSpace(b.CFrame)
				table.insert(file, b)
			end
		end
	end
	victime.Archivable = true
	local corps = Instance.new("Model")
	corps.Name = "Cadavre_" .. victime.Name
	for p, cf in pairs(finale) do
		local anatomie = p:FindFirstAncestor("Anatomie")
		if p.Name ~= "HumanoidRootPart" and p.Transparency < 1 and not anatomie then
			p.Archivable = true
			local ok, c = pcall(function()
				return p:Clone()
			end)
			if ok and c then
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("BaseScript") or d:IsA("Attachment") then
						d:Destroy()
					end
				end
				c.Anchored = true
				c.CanCollide = false
				c.CanTouch = false
				c.CFrame = cf
				c.Parent = corps
			end
		end
	end
	corps:SetAttribute("MA_Cadavre", true)
	corps.Parent = workspace
	if CONFIG.SANG.duree_cadavre and CONFIG.SANG.duree_cadavre > 0 then
		task.delay(CONFIG.SANG.duree_cadavre, function()
			if corps.Parent then
				corps:Destroy()
			end
		end)
	end
	return corps
end

local function cacherEtTuer(victime)
	for _, d in ipairs(victime:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.Transparency = 1
		end
	end
	local h = victime:FindFirstChildOfClass("Humanoid")
	if h then
		h.Health = 0
	end
	if not joueurDe(victime) then
		-- victime d'essai : retirée (les outils de test peuvent en recréer une)
		task.delay(2, function()
			if victime.Parent then
				victime:Destroy()
			end
		end)
	end
end

-- infection : la victime est relâchée vivante, symptômes après CONFIG.INFECTION.delai
local function infecter(victime)
	local debut = maintenant() + CONFIG.INFECTION.delai
	victime:SetAttribute("MA_Infection", debut)
	local h = victime:FindFirstChildOfClass("Humanoid")
	local couleurs = {}
	for _, p in ipairs(victime:GetDescendants()) do
		if p:IsA("MeshPart") and p.Transparency < 1 and not p:FindFirstAncestor("Anatomie") then
			couleurs[p] = p.Color
		end
	end
	task.spawn(function()
		attendreJusqua(debut)
		local I = CONFIG.INFECTION
		while victime.Parent and h and h.Health > 0 and victime:GetAttribute("MA_Infection") == debut do
			local k = math.clamp((maintenant() - debut) / I.duree, 0, 1)
			for p, c0 in pairs(couleurs) do
				if p.Parent then
					p.Color = c0:Lerp(Color3.new(c0.R * I.teinte_peau.R, c0.G * I.teinte_peau.G, c0.B * I.teinte_peau.B), k)
				end
			end
			if I.degats_par_seconde > 0 then
				h:TakeDamage(I.degats_par_seconde * 0.5)
			end
			if k >= 1 and I.issue == "mort" then
				h.Health = 0
				break
			end
			task.wait(0.5)
		end
	end)
end

function Monstre:liberer(victime, st, cle, t)
	local w = self.ancrePart:FindFirstChild("MA_Soudure")
	if w then
		w:Destroy()
	end
	if victime and victime.Parent then
		local vroot = victime:FindFirstChild("HumanoidRootPart")
		if vroot and cle then
			local cf = MA.ancre(self.modele, cle, t)
			if cf then
				local look = plat(cf.LookVector)
				look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
				vroot.CFrame = CFrame.lookAt(cf.Position, cf.Position + look)
			end
		end
		restaurerEtat(victime, st)
		victime:SetAttribute("MA_EnMiseAMort", nil)
		local pl = joueurDe(victime)
		if pl and vroot then
			pcall(function()
				vroot:SetNetworkOwner(pl)
			end)
		end
	end
end

function Monstre:finirSequence()
	self.modele:SetAttribute("MA_Sequence", "")
	self.modele:SetAttribute("MA_Phase", "")
	self.victimeVal.Value = nil
	self.hrp.Anchored = false
	self.hum.AutoRotate = true
	self.hum.WalkSpeed = CONFIG.VITESSE.marche
	pcall(function()
		self.hrp:SetNetworkOwner(nil)
	end)
end

function Monstre:miseAMort(victime, cle)
	local seq = SEQ[cle]
	if not seq or self.occupe then
		return false
	end
	self.occupe = true
	self.derniereMiseAMort = cle
	log("mise à mort", cle, victime.Name)
	local st
	local ok, err = pcall(function()
		self:arret()
		self.hum.AutoRotate = false
		self.modele:SetAttribute("MA_Action", "")
		local ancreCF = self:placer(victime)
		victime:SetAttribute("MA_EnMiseAMort", true)
		st = sauverEtat(victime)
		local vroot = victime.HumanoidRootPart
		pcall(function()
			vroot:SetNetworkOwner(nil)
		end)
		vroot.CFrame = ancreCF
		local w = Instance.new("Weld")
		w.Name = "MA_Soudure"
		w.Part0 = self.ancrePart
		w.Part1 = vroot
		w.C0 = CFrame.identity
		w.C1 = CFrame.identity
		w.Parent = self.ancrePart
		self.victimeVal.Value = victime
		self.modele:SetAttribute("MA_Graine", math.random(1, 1000000))
		self.modele:SetAttribute("MA_Sequence", cle)
		local derniere, tFin = nil, 0
		for _, ph in ipairs(seq.phases) do
			local c = DATA.monstre[ph.clip]
			local debut = maintenant() + AVANCE
			self.modele:SetAttribute("MA_PhaseDebut", debut)
			self.modele:SetAttribute("MA_Phase", ph.clip)
			derniere = ph.clip
			if ph.trainer then
				local trn = seq.trainer or {}
				local etiquette = trn.vers == "sortie" and CONFIG.TRAINER.etiquette_sortie or CONFIG.TRAINER.etiquette_taniere
				local vitesse = trn.vitesse or CONFIG.VITESSE.trainer
				local but = self:destination(etiquette, victime)
				attendreJusqua(debut)
				self:trainer(victime, but, vitesse, math.min(trn.distance or CONFIG.TRAINER.distance_max, CONFIG.TRAINER.distance_max))
				tFin = (maintenant() - debut)
			else
				local duree = c.length
				if ph.repas then
					duree = CONFIG.TRAINER.duree_repas
				end
				attendreJusqua(debut + duree)
				tFin = duree
			end
			if not victime.Parent then
				break
			end
		end
		if victime.Parent then
			if seq.fin == "infection" then
				self:liberer(victime, st, derniere, tFin)
				st = nil
				victime:SetAttribute("MA_Releve", maintenant() + 0.05) -- les clients jouent « se relever »
				infecter(victime)
			else
				local tPose = DATA.monstre[derniere].loop and MA.clipTime(MA.clip("monstre", derniere), tFin) or tFin
				local corps = creerCadavre(self, victime, derniere, tPose)
				-- le personnage (invisible, mort) reste sur place ; le cadavre posé le remplace
				local w = self.ancrePart:FindFirstChild("MA_Soudure")
				if w then
					w:Destroy()
				end
				local vroot = victime:FindFirstChild("HumanoidRootPart")
				if vroot then
					vroot.Anchored = true
				end
				st = nil
				if corps then
					victime:SetAttribute("MA_Cadavre", corps.Name)
				end
				cacherEtTuer(victime)
			end
		end
	end)
	if not ok then
		warn("[Monstre] mise à mort interrompue : " .. tostring(err))
		pcall(function()
			self:liberer(victime, st, nil, nil)
		end)
	end
	self:finirSequence()
	self.reposJusqua = maintenant() + CONFIG.REPOS_APRES_MISE_A_MORT
	self.cible = nil
	self.etat = "patrouille"
	self.but = nil
	if ok and self.modele.Parent then
		pcall(self.geste, self, "roar") -- hurlement de victoire avant de reprendre la patrouille
	end
	self.occupe = false
	return ok
end

------------------------------------------------------------------------------------------------------------
-- démarrage
------------------------------------------------------------------------------------------------------------
local function ajouter(modele)
	if MONSTRES[modele] or not modele:IsA("Model") then
		return
	end
	local ok, m = pcall(Monstre.new, modele)
	if not ok then
		warn("[Monstre] " .. tostring(m))
		return
	end
	MONSTRES[modele] = m
	task.spawn(function()
		m:boucle()
	end)
end

for _, modele in ipairs(CollectionService:GetTagged("Monstre")) do
	ajouter(modele)
end
CollectionService:GetInstanceAddedSignal("Monstre"):Connect(ajouter)
CollectionService:GetInstanceRemovedSignal("Monstre"):Connect(function(modele)
	MONSTRES[modele] = nil
end)

-- accès pour MonstreOutils (essais depuis la barre de commande pendant le test)
local api = Instance.new("BindableFunction")
api.Name = "MonstreAPI"
api.OnInvoke = function(action, ...)
	local args = { ... }
	local modele = args[1]
	local m = modele and MONSTRES[modele]
	if not m then
		for _, x in pairs(MONSTRES) do
			m = x
			break
		end
	end
	if not m then
		return false, "aucun monstre"
	end
	if action == "miseAMort" then
		return m:miseAMort(args[2], args[3])
	elseif action == "geste" then
		task.spawn(m.geste, m, args[2])
		return true
	elseif action == "etat" then
		return { etat = m.etat, occupe = m.occupe, cible = m.cible and m.cible.Name or "" }
	elseif action == "pause" then
		m.enPause = args[2] and true or false
		if m.enPause and not m.occupe then
			m:arret()
		end
		return true
	end
	return false, "action inconnue"
end
api.Parent = script

log("prêt :", #CollectionService:GetTagged("Monstre"), "monstre(s)")
]]></ProtectedString><bool name="Disabled">true</bool></Properties></Item><Item class="LocalScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">MonstreClient</string><ProtectedString name="Source"><![CDATA[--[[
	MonstreClient (LocalScript, StarterPlayer.StarterPlayerScripts) : tout ce qui se voit et s'entend.

	- Anime chaque monstre (étiquette « Monstre ») et sa victime à partir des attributs posés par MonstreServeur :
	  déplacement (repos / marche / course selon la vitesse, saut, chute, atterrissage), gestes, phases de mise à mort
	  (synchronisées sur l'horloge du serveur). Les Motor6D.Transform sont écrits après l'Animator.
	- Marqueurs des clips : sons, sang (giclées, éclaboussures et flaques au sol, traînée), tremblements, silence.
	- Pour la victime : caméra scénarisée (plans, coupures au noir, sang sur l'écran), commandes coupées.
	- Infection (mise à mort « contamination ») : symptômes progressifs sur le joueur infecté.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local joueur = Players.LocalPlayer
local dossier = ReplicatedStorage:WaitForChild("Monstre")
local CONFIG = require(dossier:WaitForChild("MonstreConfig"))
local DATA = require(dossier:WaitForChild("MonstreDonnees"))
local MA = require(dossier:WaitForChild("MonstreAnim")).init(DATA)
local EFFETS = dossier:FindFirstChild("Effets")

local function maintenant()
	return workspace:GetServerTimeNow()
end

local function plat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local locaux = Instance.new("Folder")
locaux.Name = "MonstreEffetsLocaux"
locaux.Parent = workspace

------------------------------------------------------------------------------------------------------------
-- sons
------------------------------------------------------------------------------------------------------------
local function jouerSon(nom, parent, volume, vitesse)
	local id = CONFIG.SONS[nom]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "MA_" .. nom
	s.SoundId = id
	s.Volume = (volume or 1) * (CONFIG.SONS.volume or 1)
	s.PlaybackSpeed = vitesse or 1
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 150
	s.Parent = parent or SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
	Debris:AddItem(s, 20)
	return s
end

-- silence : tous les sons coupés pendant `duree` secondes
local silenceJusqua = 0
local function silence(duree)
	local fin = os.clock() + duree
	if fin <= silenceJusqua then
		return
	end
	silenceJusqua = fin
	local coupes = {}
	for _, racine in ipairs({ workspace, SoundService }) do
		for _, s in ipairs(racine:GetDescendants()) do
			if s:IsA("Sound") and s.Volume > 0 then
				coupes[s] = s.Volume
				s.Volume = 0
			end
		end
	end
	task.delay(duree, function()
		if os.clock() + 0.05 < silenceJusqua then
			return
		end
		for s, v in pairs(coupes) do
			if s.Parent then
				s.Volume = v
			end
		end
	end)
end

------------------------------------------------------------------------------------------------------------
-- sang
------------------------------------------------------------------------------------------------------------
local exclusRayon = { locaux }

local function sousLePoint(pos, exclus)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclus
	return workspace:Raycast(pos + Vector3.new(0, 1.5, 0), Vector3.new(0, -40, 0), params)
end

-- MeshPart plat (gabarit importé, normale +Y) ou disque de repli, posé sur une surface
local function decalque(nom, pos, normale, taille, angle, allonge)
	if not (CONFIG.SANG.actif and CONFIG.SANG.decalques) then
		return nil
	end
	local g = EFFETS and EFFETS:FindFirstChild(nom)
	local p
	normale = normale or Vector3.yAxis
	local ref = math.abs(normale.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis
	local u = normale:Cross(ref).Unit
	local v = u:Cross(normale).Unit
	local c, s = math.cos(angle), math.sin(angle)
	local ax = u * c + v * s -- axe X du décalque (allongement) ; sur un sol plat, angle = atan2(dx, -dz)
	if g then
		p = g:Clone()
		p.Size = Vector3.new(taille * (allonge or 1), 0.02, taille)
		p.CFrame = CFrame.fromMatrix(pos + normale * 0.03, ax, normale)
	else
		p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(62, 4, 4)
		p.Size = Vector3.new(0.04, taille, taille * (allonge or 1))
		p.CFrame = CFrame.fromMatrix(pos + normale * 0.03, normale, ax)
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Parent = locaux
	Debris:AddItem(p, CONFIG.SANG.duree_decalques or 90)
	return p
end

local IMAGE_GOUTTE = EFFETS and EFFETS:GetAttribute("ImageGoutte") or "rbxasset://textures/particles/smoke_main.dds"

local function giclee(pos, dir, n)
	if not (CONFIG.SANG.actif and CONFIG.SANG.particules) then
		return
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Texture = IMAGE_GOUTTE
	e.Color = ColorSequence.new(Color3.fromRGB(110, 6, 6), Color3.fromRGB(45, 2, 2))
	e.LightEmission = 0
	e.LightInfluence = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0.08) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0.1),
		NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.35, 0.8)
	e.Speed = NumberRange.new(6, 16)
	e.SpreadAngle = Vector2.new(35, 35)
	e.Acceleration = Vector3.new(0, -workspace.Gravity * 0.35, 0)
	e.Drag = 1.5
	e.Rate = 0
	e.EmissionDirection = Enum.NormalId.Top
	if dir and dir.Magnitude > 1e-3 then
		a.WorldCFrame = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	e.Parent = a
	e:Emit(math.floor((n or 24) * (CONFIG.SANG.quantite or 1)))
	Debris:AddItem(a, 2)
end

local function pointVictime(victime, nom)
	local def = DATA.points[nom]
	if not (victime and def) then
		return nil
	end
	local part = victime:FindFirstChild(def[1])
	if not part then
		return nil
	end
	return part.CFrame * Vector3.new(def[2][1], def[2][2], def[2][3]), part
end

-- éclaboussure : giclée + taches au sol autour du point
local function eclaboussure(ctrl, quoi, rng)
	local victime = ctrl.victime
	if quoi == "frenesie" then
		quoi = ({ "cou", "poitrine", "ventre" })[rng:NextInteger(1, 3)]
	elseif quoi == "bras" then
		quoi = "brasG"
	elseif quoi == "trainee" or quoi == "sol" then
		quoi = "dos"
	end
	local pos, part = pointVictime(victime, quoi)
	if not pos then
		local head = ctrl.tete
		if not head then
			return
		end
		pos = head.Position
	end
	local dir = part and (pos - part.Position) or Vector3.yAxis
	giclee(pos, dir + Vector3.new(rng:NextNumber(-0.3, 0.3), 0.6, rng:NextNumber(-0.3, 0.3)), 26)
	local exclus = { locaux, ctrl.modele, victime }
	local nb = math.max(1, math.floor(rng:NextInteger(1, 3) * (CONFIG.SANG.quantite or 1)))
	for _ = 1, nb do
		local off = Vector3.new(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local r = sousLePoint(pos + off, exclus)
		if r then
			local nom = "SANG_Eclaboussure_" .. rng:NextInteger(1, 3)
			decalque(nom, r.Position, r.Normal, rng:NextNumber(1.2, 2.8), rng:NextNumber(0, math.pi * 2))
		end
	end
end

-- flaque qui s'étend sous le corps
local function flaque(ctrl, quoi, rng)
	local pos = pointVictime(ctrl.victime, quoi == "cou" and "cou" or "dos") or (ctrl.hrp and ctrl.hrp.Position)
	if not pos then
		return
	end
	local r = sousLePoint(pos, { locaux, ctrl.modele, ctrl.victime })
	if not r then
		return
	end
	local p = decalque("SANG_Flaque", r.Position, r.Normal, 0.6, rng:NextNumber(0, math.pi * 2))
	if not p then
		return
	end
	local cf = p.CFrame
	local fin = rng:NextNumber(4.5, 6.5)
	task.spawn(function()
		local t0 = os.clock()
		while p.Parent and os.clock() - t0 < 6 do
			local k = (os.clock() - t0) / 6
			local tl = 0.6 + (fin - 0.6) * (1 - (1 - k) ^ 2)
			if p:IsA("MeshPart") then
				p.Size = Vector3.new(tl, 0.02, tl)
			else
				p.Size = Vector3.new(0.04, tl, tl)
			end
			p.CFrame = cf
			task.wait(0.05)
		end
	end)
end

------------------------------------------------------------------------------------------------------------
-- écran (victime) : noir, sang, vignette
------------------------------------------------------------------------------------------------------------
local ecran = Instance.new("ScreenGui")
ecran.Name = "MonstreEcran"
ecran.IgnoreGuiInset = true
ecran.ResetOnSpawn = false
ecran.DisplayOrder = 50
ecran.Parent = joueur:WaitForChild("PlayerGui")

local noir = Instance.new("Frame")
noir.Name = "Noir"
noir.Size = UDim2.fromScale(1, 1)
noir.BackgroundColor3 = Color3.new(0, 0, 0)
noir.BackgroundTransparency = 1
noir.BorderSizePixel = 0
noir.ZIndex = 20
noir.Parent = ecran

local rouge = Instance.new("Frame")
rouge.Name = "Rouge"
rouge.Size = UDim2.fromScale(1, 1)
rouge.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
rouge.BackgroundTransparency = 1
rouge.BorderSizePixel = 0
rouge.ZIndex = 10
rouge.Parent = ecran

-- vignette : quatre bords en dégradé (aucune image à importer)
local vignette = {}
for i, def in ipairs({ { UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0), 90 }, { UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0.65), -90 },
	{ UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), 0 }, { UDim2.fromScale(0.3, 1), UDim2.fromScale(0.7, 0), 180 } }) do
	local f = Instance.new("Frame")
	f.Name = "Vignette" .. i
	f.Size = def[1]
	f.Position = def[2]
	f.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 0
	f.ZIndex = 5
	local g = Instance.new("UIGradient")
	g.Rotation = def[3]
	g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	g.Parent = f
	f.Visible = false
	f.Parent = ecran
	vignette[i] = f
end

local function vignetteForce(k, couleur)
	for _, f in ipairs(vignette) do
		f.Visible = k > 0.01
		f.BackgroundTransparency = 1 - math.clamp(k, 0, 1)
		if couleur then
			f.BackgroundColor3 = couleur
		end
	end
end

local function fondu(frame, de, a, duree)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < duree do
			frame.BackgroundTransparency = de + (a - de) * ((os.clock() - t0) / duree)
			RunService.RenderStepped:Wait()
		end
		frame.BackgroundTransparency = a
	end)
end

local function coupure(duree)
	noir.BackgroundTransparency = 0
	task.delay(duree, function()
		fondu(noir, 0, 1, 0.3)
	end)
end

local function flashRouge(force)
	rouge.BackgroundTransparency = 1 - force
	fondu(rouge, 1 - force, 1, 0.5)
end

-- sang sur l'écran : gabarit SANG_Ecran (plan importé) devant la caméra, sinon taches d'interface
local sangEcran = nil
local sangEcranDebut = 0
local function sangSurEcran()
	if not (CONFIG.SANG.actif and CONFIG.SANG.ecran) then
		return
	end
	sangEcranDebut = os.clock()
	local g = EFFETS and EFFETS:FindFirstChild("SANG_Ecran")
	if g then
		if not sangEcran then
			sangEcran = g:Clone()
			sangEcran.Anchored = true
			sangEcran.CanCollide = false
			sangEcran.CanQuery = false
			sangEcran.CanTouch = false
			sangEcran.CastShadow = false
			sangEcran.Parent = workspace.CurrentCamera
		end
	else
		local rng = Random.new()
		for _ = 1, 7 do
			local f = Instance.new("Frame")
			local s = rng:NextNumber(0.08, 0.25)
			f.Size = UDim2.fromScale(s, s * 1.6)
			f.Position = UDim2.fromScale(rng:NextNumber(0, 0.9), rng:NextNumber(0, 0.85))
			f.BackgroundColor3 = Color3.fromRGB(rng:NextInteger(70, 120), 0, 0)
			f.BorderSizePixel = 0
			f.BackgroundTransparency = 0.15
			f.ZIndex = 8
			local cc = Instance.new("UICorner")
			cc.CornerRadius = UDim.new(0.5, 0)
			cc.Parent = f
			f.Parent = ecran
			fondu(f, 0.15, 1, 4)
			Debris:AddItem(f, 4.2)
		end
	end
end

local function majSangEcran()
	if not sangEcran then
		return
	end
	local cam = workspace.CurrentCamera
	local k = (os.clock() - sangEcranDebut) / 4.5
	if k >= 1 then
		sangEcran:Destroy()
		sangEcran = nil
		return
	end
	local d = 0.6
	local h = 2 * d * math.tan(math.rad(cam.FieldOfView) / 2)
	local w = h * cam.ViewportSize.X / math.max(cam.ViewportSize.Y, 1)
	sangEcran.Size = Vector3.new(w * 1.05, 0.01, h * 1.05)
	sangEcran.CFrame = cam.CFrame * CFrame.new(0, 0, -d) * CFrame.Angles(math.rad(90), 0, 0)
	sangEcran.Transparency = k ^ 2
end

------------------------------------------------------------------------------------------------------------
-- commandes et caméra de la victime
------------------------------------------------------------------------------------------------------------
local controles = nil
local function commandes(actif)
	if not controles then
		local ok, pm = pcall(function()
			return require(joueur:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5))
		end)
		if ok and pm then
			controles = pm:GetControls()
		end
	end
	if controles then
		if actif then
			controles:Enable()
		else
			controles:Disable()
		end
	end
end

local CAM = { actif = false, mode = nil, tremble = 0, cf = nil, coupe = false, fixe = nil, ctrl = nil }

local function partie(modele, ...)
	if not modele then
		return nil
	end
	for _, nom in ipairs({ ... }) do
		local p = modele:FindFirstChild(nom, true)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return modele.PrimaryPart
end

local function cameraMode(mode)
	if not CONFIG.CAMERA.active then
		return
	end
	if mode == "retour" then
		CAM.actif = false
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		local h = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
		if h then
			cam.CameraSubject = h
		end
		return
	end
	if mode == "tremble" then
		CAM.tremble = math.max(CAM.tremble, 0.7)
		return
	end
	CAM.actif = true
	CAM.mode = mode
	CAM.fixe = nil
	CAM.depuis = os.clock()
end

local function cibleCamera(ctrl)
	if CAM.mode == "cadavre" then -- au-dessus du corps (cadavre posé, sinon dernière position du torse)
		local corps = ctrl.cadavre
		local p = corps and corps.Parent and (corps:FindFirstChild("Torso") or corps:FindFirstChildWhichIsA("BasePart"))
		local centre = p and p.Position or ctrl.dernierCentre
		if not centre then
			return nil
		end
		local a = (os.clock() - CAM.depuis) * 0.15
		return CFrame.lookAt(centre + Vector3.new(math.cos(a) * 5, 9, math.sin(a) * 5), centre)
	end
	local m, v = ctrl.modele, ctrl.victime
	local teteM = partie(m, "MON_Head_1", "HumanoidRootPart")
	local hautM = partie(m, "MON_UpperChest_1", "HumanoidRootPart")
	local teteV = partie(v, "Head")
	local torseV = partie(v, "Torso", "UpperTorso", "HumanoidRootPart")
	local mode = CAM.mode
	if not (teteM and torseV) then
		return nil
	end
	if mode == "victime" and teteV then
		local o = teteV.CFrame * Vector3.new(0, 0.15, -0.55)
		return CFrame.lookAt(o, teteM.Position)
	elseif mode == "epaule_victime" then
		local o = torseV.CFrame * Vector3.new(1.8, 1.6, 4.2)
		return CFrame.lookAt(o, teteM.Position:Lerp(torseV.Position, 0.35))
	elseif mode == "face" or mode == "suivre" then
		local mid = teteM.Position:Lerp(torseV.Position, 0.55)
		local axe = plat(torseV.Position - ctrl.hrp.Position)
		axe = axe.Magnitude > 0.1 and axe.Unit or Vector3.zAxis
		local cote = axe:Cross(Vector3.yAxis)
		if not CAM.fixe then
			CAM.fixe = { cote = cote }
		end
		local o = mid + CAM.fixe.cote * 11 + Vector3.new(0, 1.5, 0) + axe * 2
		return CFrame.lookAt(o, mid)
	elseif mode == "epaule_monstre" and hautM then
		local o = hautM.CFrame * Vector3.new(2.6, 3.2, 5.5)
		return CFrame.lookAt(o, torseV.Position)
	elseif mode == "distance" then
		-- caméra posée à l'écart ; elle ne suit le monstre que s'il s'éloigne de plus de 26 studs
		if not CAM.fixe then
			local axe = plat(torseV.Position - ctrl.hrp.Position)
			axe = axe.Magnitude > 0.1 and axe.Unit or Vector3.zAxis
			CAM.fixe = { pos = torseV.Position + axe * 14 + axe:Cross(Vector3.yAxis) * 9 + Vector3.new(0, 6, 0) }
		end
		local vers = plat(ctrl.hrp.Position - CAM.fixe.pos)
		if vers.Magnitude > 26 then
			CAM.fixe.pos += vers.Unit * (vers.Magnitude - 26)
		end
		return CFrame.lookAt(CAM.fixe.pos, ctrl.hrp.Position)
	elseif mode == "trainee" and teteV then
		local loin = plat(teteV.Position - ctrl.hrp.Position)
		loin = loin.Magnitude > 0.1 and loin.Unit or Vector3.zAxis
		local o = teteV.Position + loin * 1.6 + Vector3.new(0, 1.6, 0)
		return CFrame.lookAt(o, hautM and hautM.Position or ctrl.hrp.Position)
	elseif mode == "fige" then
		return CAM.cf
	end
	return nil
end

local bruit = Random.new()
RunService:BindToRenderStep("MonstreCamera", Enum.RenderPriority.Camera.Value + 5, function(dt)
	majSangEcran()
	if not (CAM.actif and CAM.ctrl) then
		return
	end
	local cam = workspace.CurrentCamera
	local cible = cibleCamera(CAM.ctrl)
	if not cible then
		return
	end
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = CONFIG.CAMERA.champ or 60
	if not CAM.cf or CAM.coupe then
		CAM.cf = cible
		CAM.coupe = false
	else
		CAM.cf = CAM.cf:Lerp(cible, 1 - math.exp(-dt * 7))
	end
	local cf = CAM.cf
	if CAM.tremble > 0.01 then
		local a = CAM.tremble * (CONFIG.CAMERA.tremblement or 1)
		cf = cf * CFrame.Angles(bruit:NextNumber(-1, 1) * 0.03 * a, bruit:NextNumber(-1, 1) * 0.03 * a, bruit:NextNumber(-1, 1) * 0.02 * a)
		CAM.tremble = CAM.tremble * math.exp(-dt * 3.5)
	end
	cam.CFrame = cf
end)

------------------------------------------------------------------------------------------------------------
-- monstres
------------------------------------------------------------------------------------------------------------
local CTRL = {}

local function victimeAnim(ctrl, victime)
	if ctrl.victime == victime and ctrl.vlec then
		return ctrl.vlec
	end
	ctrl.victime = victime
	ctrl.vlec = nil
	if victime then
		local moteurs = MA.moteurs(victime, "victime")
		if moteurs.Torso or moteurs.Head then
			ctrl.vlec = MA.lecteur("victime", moteurs)
		end
	end
	return ctrl.vlec
end

local function estVictimeLocale(ctrl)
	return ctrl.victime ~= nil and ctrl.victime == joueur.Character
end

local function effetMarqueur(ctrl, m)
	local nom, val = m[2], m[3]
	if m[4] - m[1] > 0.6 then
		return -- client arrivé en retard : on ne rejoue pas les vieux effets
	end
	ctrl.compteur = (ctrl.compteur or 0) + 1
	local rng = Random.new((ctrl.graine or 0) * 131 + ctrl.compteur)
	local moi = estVictimeLocale(ctrl)
	local distance = (workspace.CurrentCamera.CFrame.Position - ctrl.hrp.Position).Magnitude
	if nom == "Son" then
		jouerSon(val, ctrl.tete or ctrl.hrp, 1, rng:NextNumber(0.94, 1.06))
	elseif nom == "Eclaboussure" then
		eclaboussure(ctrl, val, rng)
	elseif nom == "Flaque" then
		flaque(ctrl, val, rng)
	elseif nom == "Trace" then
		ctrl.trace = { derniere = nil }
	elseif nom == "Morsure" or nom == "Coup" or nom == "Impact" or nom == "Retrait" then
		if moi then
			CAM.tremble = math.max(CAM.tremble, nom == "Impact" and 1.2 or 0.8)
			flashRouge(nom == "Morsure" and 0.35 or 0.25)
		elseif distance < 25 then
			CAM.tremble = math.max(CAM.tremble, 0.15)
		end
	elseif nom == "Tremble" then
		if moi then
			CAM.tremble = math.max(CAM.tremble, tonumber(val) or 0.6)
		end
	elseif nom == "Camera" then
		if moi then
			cameraMode(val)
		end
	elseif nom == "Coupure" then
		if moi then
			coupure(tonumber(val) or 0.4)
			CAM.coupe = true
		end
	elseif nom == "Ecran" then
		if moi then
			sangSurEcran()
		end
	elseif nom == "Silence" then
		if moi or distance < 60 then
			silence(tonumber(val) or 2.5)
		end
	elseif nom == "Infection" then
		if moi then
			flashRouge(0.5)
			vignetteForce(0.6, Color3.fromRGB(10, 30, 5))
			task.delay(0.8, function()
				vignetteForce(0)
			end)
		end
	end
end

-- traînée de sang derrière la victime
local function majTrace(ctrl)
	local tr = ctrl.trace
	if not tr or not ctrl.victime then
		return
	end
	local pos = pointVictime(ctrl.victime, "dos")
	if not pos then
		return
	end
	if not tr.derniere then
		tr.derniere = pos
		return
	end
	local d = plat(pos - tr.derniere)
	if d.Magnitude < 1.3 then
		return
	end
	local mid = tr.derniere:Lerp(pos, 0.5)
	local r = sousLePoint(mid, { locaux, ctrl.modele, ctrl.victime })
	if r then
		decalque("SANG_Trainee", r.Position, r.Normal, 1.6, math.atan2(d.X, -d.Z), d.Magnitude / 1.6 + 0.25)
	end
	tr.derniere = pos
end

local function nouveauMonstre(modele)
	if CTRL[modele] then
		return
	end
	local hrp = modele:WaitForChild("HumanoidRootPart", 10)
	if not hrp then
		return
	end
	local ctrl = {
		modele = modele,
		hrp = hrp,
		tete = partie(modele, "MON_Head_1"),
		lec = MA.lecteur("monstre", MA.moteurs(modele, "monstre")),
		air = 0,
		vy = 0,
		saut = nil,
	}
	ctrl.lec:jouer("base", "idle", { horloge = os.clock })
	CTRL[modele] = ctrl
	modele.DescendantAdded:Connect(function(d) -- pièces arrivées en retard (StreamingEnabled) : on reprend les Motor6D
		if d:IsA("Motor6D") then
			ctrl.lec.moteurs = MA.moteurs(modele, "monstre")
		end
	end)
end

local function finSequence(ctrl)
	local victime = ctrl.victime
	local moi = estVictimeLocale(ctrl)
	if ctrl.vlec then
		ctrl.vlec:arreterAction(0.15)
		ctrl.vlec:etape(1)
		for _, mo in pairs(ctrl.vlec.moteurs) do
			mo.Transform = CFrame.identity
		end
	end
	ctrl.vlec = nil
	ctrl.trace = nil
	ctrl.sequence = nil
	ctrl.victime = nil
	ctrl.phaseKey = nil
	if moi then
		local corpsNom = victime and victime:GetAttribute("MA_Cadavre")
		if corpsNom and victime:GetAttribute("MA_Infection") == nil then
			ctrl.cadavre = workspace:FindFirstChild(corpsNom)
			CAM.ctrl = ctrl
			cameraMode("cadavre")
		else
			cameraMode("retour")
			CAM.ctrl = nil
			if not (victime and victime:GetAttribute("MA_Infection")) then
				commandes(true) -- sinon après « se relever »
			end
		end
	end
end

-- relevé de la victime contaminée (tous les clients jouent « se relever » sur son personnage)
local releves = {}
local function majReleves(dt)
	for perso, r in pairs(releves) do
		if not perso.Parent or os.clock() - r.t0 > 1.4 then
			if r.lec then
				for _, mo in pairs(r.lec.moteurs) do
					mo.Transform = CFrame.identity
				end
			end
			releves[perso] = nil
			if perso == joueur.Character then
				commandes(true)
			end
		elseif r.lec then
			r.lec:etape(dt)
		end
	end
end

local function surveillerReleve(perso)
	perso:GetAttributeChangedSignal("MA_Releve"):Connect(function()
		local t = perso:GetAttribute("MA_Releve")
		if t and DATA.victime.getup then
			local lec = MA.lecteur("victime", MA.moteurs(perso, "victime"))
			lec:jouer("action", "getup", { horloge = maintenant, debut = t, fondu = 0.2 })
			releves[perso] = { lec = lec, t0 = os.clock() }
		end
	end)
end

local function majMonstre(ctrl, dt)
	local m = ctrl.modele
	local lec = ctrl.lec
	local seq = m:GetAttribute("MA_Sequence") or ""
	local phase = m:GetAttribute("MA_Phase") or ""
	local action = m:GetAttribute("MA_Action") or ""
	-- déplacement
	local v = ctrl.hrp.AssemblyLinearVelocity
	local hv = plat(v).Magnitude
	if hv < 0.6 then
		lec:jouer("base", "idle", { horloge = os.clock, fondu = 0.3 })
	elseif hv < (CONFIG.VITESSE.marche + CONFIG.VITESSE.course) / 2 then
		local l = lec:jouer("base", "walk", { horloge = os.clock, fondu = 0.3 })
		if l then
			l.vitesse = math.clamp(hv / DATA.monstre.walk.speed, 0.4, 2)
		end
	else
		local l = lec:jouer("base", "run", { horloge = os.clock, fondu = 0.25 })
		if l then
			l.vitesse = math.clamp(hv / DATA.monstre.run.speed, 0.5, 1.6)
		end
	end
	-- en l'air ?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { m, locaux }
	local auSol = ctrl.hrp.Anchored or workspace:Raycast(ctrl.hrp.Position, Vector3.new(0, -(DATA.rig.hrp.center[2] + 1.2), 0), params) ~= nil
	if auSol then
		if ctrl.air > 0.3 and ctrl.vy < -12 then
			ctrl.atterrit = os.clock()
		end
		ctrl.air = 0
	else
		ctrl.air += dt
	end
	ctrl.vy = v.Y
	-- couche d'action
	if seq ~= "" and phase ~= "" then
		local debut = m:GetAttribute("MA_PhaseDebut") or 0
		if ctrl.sequence ~= seq then
			ctrl.sequence = seq
			ctrl.graine = m:GetAttribute("MA_Graine") or 0
			ctrl.compteur = 0
			ctrl.cadavre = nil
		end
		local vv = m:FindFirstChild("MA_Victime")
		local victime = vv and vv.Value
		if ctrl.phaseKey ~= phase or ctrl.phaseDebut ~= debut then
			local premier = ctrl.phaseKey == nil
			lec:jouer("action", phase, { horloge = maintenant, debut = debut, fondu = premier and 0.15 or 0.3, relancer = true })
			local vl = victimeAnim(ctrl, victime)
			if vl and DATA.victime[phase] then
				vl:jouer("action", phase, { horloge = maintenant, debut = debut, fondu = premier and 0.12 or 0.3, relancer = true })
			end
			ctrl.phaseKey, ctrl.phaseDebut = phase, debut
			ctrl.trace = nil
			if premier and estVictimeLocale(ctrl) then
				CAM.ctrl = ctrl
				CAM.cf = nil
				commandes(false)
			end
		end
	elseif ctrl.sequence then
		finSequence(ctrl)
		lec:arreterAction(0.4)
	elseif action ~= "" then
		local debut = m:GetAttribute("MA_ActionDebut") or 0
		local c = DATA.monstre[action]
		if c and maintenant() < debut + c.length then
			if not lec:action() or lec:action().key ~= action or ctrl.actionDebut ~= debut then
				lec:jouer("action", action, { horloge = maintenant, debut = debut, fondu = 0.2, relancer = true })
				ctrl.actionDebut = debut
			end
		else
			lec:arreterAction(0.3)
		end
	elseif ctrl.air > 0.25 or (not auSol and v.Y > 6) then
		if v.Y > 2 then
			if not lec:action() or lec:action().key ~= "jump" then
				lec:jouer("action", "jump", { horloge = os.clock, fondu = 0.1 })
			end
		elseif not lec:action() or lec:action().key ~= "fall" then
			lec:jouer("action", "fall", { horloge = os.clock, fondu = 0.3 })
		end
	elseif ctrl.atterrit and os.clock() - ctrl.atterrit < DATA.monstre.land.length then
		if not lec:action() or lec:action().key ~= "land" then
			lec:jouer("action", "land", { horloge = os.clock, fondu = 0.08, relancer = true })
		end
	else
		lec:arreterAction(0.3)
	end
	local evts = lec:etape(dt)
	if ctrl.vlec then
		ctrl.vlec:etape(dt)
		local torse = ctrl.victime and ctrl.victime:FindFirstChild("Torso")
		if torse then
			ctrl.dernierCentre = torse.Position
		end
	end
	for _, e in ipairs(evts) do
		if ctrl.sequence or e[2] == "Son" then
			effetMarqueur(ctrl, e)
		end
	end
end

RunService.PreSimulation:Connect(function(dt)
	for modele, ctrl in pairs(CTRL) do
		if not modele.Parent then
			CTRL[modele] = nil
		else
			local ok, err = pcall(majMonstre, ctrl, dt)
			if not ok then
				warn("[MonstreClient] " .. tostring(err))
			end
		end
	end
	majReleves(dt)
end)

RunService.Heartbeat:Connect(function()
	for _, ctrl in pairs(CTRL) do
		if ctrl.trace then
			majTrace(ctrl)
		end
	end
end)

for _, m in ipairs(CollectionService:GetTagged("Monstre")) do
	task.spawn(nouveauMonstre, m)
end
CollectionService:GetInstanceAddedSignal("Monstre"):Connect(function(m)
	task.spawn(nouveauMonstre, m)
end)

------------------------------------------------------------------------------------------------------------
-- infection du joueur local
------------------------------------------------------------------------------------------------------------
local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "MonstreInfection"
cc.Enabled = false
cc.Parent = Lighting
local flou = Instance.new("BlurEffect")
flou.Name = "MonstreInfectionFlou"
flou.Size = 0
flou.Enabled = false
flou.Parent = Lighting
local INF = { prochainCoeur = 0, prochaineToux = 0, balance = 0 }

local function finInfection()
	cc.Enabled = false
	flou.Enabled = false
	vignetteForce(0)
end

RunService:BindToRenderStep("MonstreInfection", Enum.RenderPriority.Camera.Value + 6, function(dt)
	local perso = joueur.Character
	local debut = perso and perso:GetAttribute("MA_Infection")
	local h = perso and perso:FindFirstChildOfClass("Humanoid")
	if not (debut and h and h.Health > 0) then
		if cc.Enabled then
			finInfection()
		end
		return
	end
	local t = maintenant()
	if t < debut then
		return
	end
	local I = CONFIG.INFECTION
	local k = math.clamp((t - debut) / I.duree, 0, 1)
	local s = 0.25 + 0.75 * k -- les symptômes commencent faibles
	cc.Enabled = true
	cc.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(205, 235, 190), s)
	cc.Saturation = -0.55 * s
	cc.Contrast = 0.2 * s
	local pouls = (0.5 + 0.5 * math.sin(os.clock() * (2.2 + 2 * s))) ^ 6
	flou.Enabled = true
	flou.Size = (2 + 10 * s) * pouls
	vignetteForce((0.25 + 0.5 * s) * (0.75 + 0.25 * pouls), Color3.fromRGB(14, 24, 8))
	if os.clock() > INF.prochainCoeur then
		INF.prochainCoeur = os.clock() + (1.25 - 0.55 * s)
		jouerSon("battement", nil, 0.5 + 0.5 * s)
	end
	if os.clock() > INF.prochaineToux then
		INF.prochaineToux = os.clock() + 6 + math.random() * (14 - 8 * s)
		if INF.dejaToux then
			jouerSon("toux", nil, 0.8)
			CAM.tremble = math.max(CAM.tremble, 0.25)
		end
		INF.dejaToux = true
	end
	-- vitesse plafonnée, caméra qui tangue
	local f = 1 + (I.vitesse_min - 1) * s
	if h.WalkSpeed > 16 * f then
		h.WalkSpeed = 16 * f
	end
	if not CAM.actif then
		local cam = workspace.CurrentCamera
		INF.balance += dt
		cam.CFrame = cam.CFrame * CFrame.Angles(math.sin(INF.balance * 0.9) * 0.012 * s, 0, math.sin(INF.balance * 0.6) * 0.03 * s)
	end
end)

local function nouveauPerso(perso)
	finInfection()
	CAM.actif = false
	CAM.ctrl = nil
	noir.BackgroundTransparency = 1
	if controles then
		commandes(true) -- coupées pendant une mise à mort : rendues au nouveau personnage
	end
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	surveillerReleve(perso)
end
joueur.CharacterAdded:Connect(nouveauPerso)
if joueur.Character then
	nouveauPerso(joueur.Character)
end
for _, p in ipairs(Players:GetPlayers()) do
	if p ~= joueur then
		if p.Character then
			surveillerReleve(p.Character)
		end
		p.CharacterAdded:Connect(surveillerReleve)
	end
end
Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(surveillerReleve)
end)
for _, m in ipairs(CollectionService:GetTagged(CONFIG.ETIQUETTE_VICTIME)) do
	surveillerReleve(m)
end
]]></ProtectedString></Properties></Item></Item></roblox>
