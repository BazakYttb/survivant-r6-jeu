<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Folder" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">Monstre_Kit</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Installateur</string><ProtectedString name="Source"><![CDATA[--[[
	Installateur du monstre (ModuleScript du kit Monstre_Kit). Dans Roblox Studio, en mode édition :
		1. Importer 3D : monstre/export/Monstre.fbx (ou .glb) ;
		2. insérer monstre/roblox/Monstre_Kit.rbxmx (clic droit sur Workspace > Insérer depuis un fichier) ;
		3. barre de commande :  require(workspace.Monstre_Kit.Installateur)()
	Options : require(...)({ position = Vector3, garderConfig = true, victimeTest = false })

	Ce que fait l'installation (annulable avec Ctrl+Z) :
	- retrouve l'import (maillages MON_*, marqueurs REF_A..REF_D), en déduit échelle et orientation, remet le modèle à
	  l'échelle 1 (1 unité = 1 stud), debout, face à sa direction d'origine ;
	- monte le rig : HumanoidRootPart, un Motor6D par pièce (37) au pivot de son articulation (C0/C1 alignés sur les
	  axes du modèle), pièce VictimeAncre (la victime y est soudée pendant une mise à mort), Humanoid (R15, HipHeight),
	  lueur de la gueule (pièce Neon + PointLight à GLOW_MOUTH) ;
	- range les gabarits de sang SANG_* (ReplicatedStorage.Monstre.Effets, transparence par l'alpha) ;
	- installe les scripts : ReplicatedStorage.Monstre (MonstreAnim, MonstreConfig, MonstreDonnees, Effets),
	  ServerScriptService.MonstreServeur, StarterPlayerScripts.MonstreClient, ServerStorage.MonstreOutils.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local CollectionService = game:GetService("CollectionService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")

local KIT = script.Parent

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function trouverImports()
	local out = {}
	local vus = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == "REF_A" and d:IsA("BasePart") then
			local m = d.Parent
			while m and m.Parent ~= workspace and not (m:IsA("Model") and m:FindFirstChild("REF_B", true) and m:FindFirstChild("REF_C", true)) do
				m = m.Parent
			end
			if m and m:IsA("Model") and not vus[m] and not m:GetAttribute("MA_Installe") then
				vus[m] = true
				table.insert(out, m)
			end
		end
	end
	return out
end

local function choisirImport()
	local liste = trouverImports()
	if #liste <= 1 then
		return liste[1]
	end
	for _, s in ipairs(Selection:Get()) do
		for _, m in ipairs(liste) do
			if s == m or s:IsDescendantOf(m) then
				return m
			end
		end
	end
	return nil, "plusieurs imports du monstre : sélectionnez celui à installer"
end

-- repère du modèle d'après les marqueurs : M (axes unitaires), échelle s (studs par unité du modèle)
local function repere(modele, data)
	local function pos(nom)
		local p = modele:FindFirstChild(nom, true)
		return p and p:IsA("BasePart") and p.Position or nil
	end
	local A, B, C, D = pos("REF_A"), pos("REF_B"), pos("REF_C"), pos("REF_D")
	if not (A and B and C) then
		return nil, "marqueurs REF_A, REF_B ou REF_C introuvables"
	end
	local mk = data.rig.markers
	local dAB = (v3(mk.REF_B) - v3(mk.REF_A)).Magnitude
	local s = (B - A).Magnitude / dAB
	if s < 1e-4 then
		return nil, "marqueurs confondus"
	end
	local up = (B - A).Unit
	local ac = C - A
	local right = (ac - up * ac:Dot(up))
	if right.Magnitude < 1e-6 then
		return nil, "marqueurs alignés"
	end
	right = right.Unit
	local back = right:Cross(up)
	if D then
		local attendu = v3(mk.REF_D) - v3(mk.REF_A) -- (0, 0, -1) dans le modèle
		local mesure = (D - A) / s
		local z = mesure:Dot(back)
		if attendu.Z ~= 0 and z * attendu.Z < 0 then
			return nil, "import en miroir (REF_D du mauvais côté) : réimportez sans inverser d'axe"
		end
	end
	local origine = A - up * (v3(mk.REF_A).Y * s) - right * (v3(mk.REF_A).X * s) - back * (v3(mk.REF_A).Z * s)
	return CFrame.fromMatrix(origine, right, up, back), s
end

local function nomPiece(nom)
	local piece, n = string.match(nom, "^MON_(.+)_(%d+)$")
	return piece, tonumber(n)
end

local function installerScripts(opts, rapport)
	local data = KIT:FindFirstChild("MonstreDonnees")
	local dossier = ReplicatedStorage:FindFirstChild("Monstre")
	if not dossier then
		dossier = Instance.new("Folder")
		dossier.Name = "Monstre"
		dossier.Parent = ReplicatedStorage
	end
	for _, nom in ipairs({ "MonstreAnim", "MonstreDonnees", "MonstreConfig" }) do
		local src = KIT:FindFirstChild(nom)
		local ancien = dossier:FindFirstChild(nom)
		if nom == "MonstreConfig" and ancien and opts.garderConfig ~= false then
			table.insert(rapport, "MonstreConfig existant conservé (garderConfig = false pour le remplacer)")
		elseif src then
			if ancien then
				ancien:Destroy()
			end
			src:Clone().Parent = dossier
		end
	end
	if not dossier:FindFirstChild("Effets") then
		local e = Instance.new("Folder")
		e.Name = "Effets"
		e.Parent = dossier
	end
	local function placer(nom, parent)
		local src = KIT:FindFirstChild(nom)
		if not src then
			table.insert(rapport, "ATTENTION : " .. nom .. " absent du kit")
			return
		end
		local ancien = parent:FindFirstChild(nom)
		if ancien then
			ancien:Destroy()
		end
		local c = src:Clone()
		if c:IsA("Script") then -- désactivé dans le kit (le kit peut être dans le Workspace)
			pcall(function()
				c.Enabled = true
			end)
			pcall(function()
				c.Disabled = false
			end)
		end
		c.Parent = parent
	end
	placer("MonstreServeur", ServerScriptService)
	local sps = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
	if not sps then
		sps = Instance.new("StarterPlayerScripts")
		sps.Parent = StarterPlayer
	end
	placer("MonstreClient", sps)
	placer("MonstreOutils", ServerStorage)
	return dossier, data
end

local function preparerEffets(modele, dossier, rapport)
	local effets = dossier:FindFirstChild("Effets")
	local n = 0
	for _, d in ipairs(modele:GetDescendants()) do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 5) == "SANG_" then
			local ancien = effets:FindFirstChild(d.Name)
			if ancien then
				ancien:Destroy()
			end
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.CastShadow = false
			d.Massless = true
			local sa = d:FindFirstChildOfClass("SurfaceAppearance")
			if sa then
				pcall(function()
					sa.AlphaMode = Enum.AlphaMode.Transparency
				end)
				if d.Name == "SANG_Goutte" then
					local ok, id = pcall(function()
						return sa.ColorMap
					end)
					if ok and type(id) == "string" and id ~= "" then
						effets:SetAttribute("ImageGoutte", id)
					end
				end
			elseif d:IsA("MeshPart") and d.Name == "SANG_Goutte" and d.TextureID ~= "" then
				effets:SetAttribute("ImageGoutte", d.TextureID)
			end
			d.Parent = effets
			n += 1
		end
	end
	table.insert(rapport, string.format("%d gabarit(s) de sang rangé(s) dans ReplicatedStorage.Monstre.Effets", n))
end

return function(opts)
	opts = opts or {}
	local rapport = {}
	local enreg = nil
	pcall(function()
		enreg = ChangeHistoryService:TryBeginRecording("InstallerMonstre", "Installer le monstre")
	end)
	local ok, res = pcall(function()
		local modele, err = choisirImport()
		local dossier, dataModule = installerScripts(opts, rapport)
		local data = require(dataModule)
		if not modele then
			local deja = nil
			for _, m in ipairs(CollectionService:GetTagged("Monstre")) do
				deja = m
			end
			if deja then
				table.insert(rapport, "monstre déjà installé (" .. deja:GetFullName() .. ") : scripts et données mis à jour")
				return deja
			end
			error(err or "aucun import du monstre trouvé (Importer 3D : monstre/export/Monstre.fbx)")
		end
		local M, s = repere(modele, data)
		if not M then
			error(s)
		end
		table.insert(rapport, string.format("import trouvé : %s (échelle %.4g, remis à 1 stud par unité)", modele:GetFullName(), s))
		-- placement debout, face à la direction d'origine (horizontale)
		local avant = -M.ZVector
		avant = Vector3.new(avant.X, 0, avant.Z)
		avant = avant.Magnitude > 1e-3 and avant.Unit or Vector3.new(0, 0, -1)
		local o = opts.position or M.Position
		local M2 = CFrame.lookAt(o, o + avant)
		-- remise à l'échelle et à plat de toutes les pièces
		local parties = {}
		for _, d in ipairs(modele:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(parties, d)
			end
		end
		for _, p in ipairs(parties) do
			local lp = M:PointToObjectSpace(p.Position) / s
			local lr = M.Rotation:Inverse() * p.CFrame.Rotation
			p.Anchored = true
			p.Size = p.Size / s
			p.CFrame = M2 * CFrame.new(lp) * lr
		end
		-- pièces du rig
		local principal, extras = {}, {}
		for _, p in ipairs(parties) do
			local piece, n = nomPiece(p.Name)
			if piece then
				if n == 1 or not principal[piece] then
					if principal[piece] then
						table.insert(extras, { piece, principal[piece] })
					end
					principal[piece] = p
				else
					table.insert(extras, { piece, p })
				end
			end
		end
		local manquantes = {}
		for _, def in ipairs(data.rig.parts) do
			if def.name ~= "VictimeAncre" and not principal[def.name] then
				table.insert(manquantes, def.name)
			end
		end
		if #manquantes > 0 then
			error("pièces absentes de l'import : " .. table.concat(manquantes, ", "))
		end
		local hrp = modele:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp:Destroy()
		end
		hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = v3(data.rig.hrp.size)
		hrp.Transparency = 1
		hrp.CanCollide = true
		hrp.Anchored = true
		hrp.CFrame = M2 * CFrame.new(v3(data.rig.hrp.center))
		hrp.Parent = modele
		modele.PrimaryPart = hrp
		local nbMoteurs = 0
		for _, def in ipairs(data.rig.parts) do
			local pivotCF = M2 * CFrame.new(v3(def.pivot))
			local p0 = def.parent == "HumanoidRootPart" and hrp or principal[def.parent]
			local p1
			if def.name == "VictimeAncre" then
				p1 = modele:FindFirstChild("VictimeAncrePart") or Instance.new("Part")
				p1.Name = "VictimeAncrePart"
				p1.Size = Vector3.new(1, 1, 1)
				p1.Transparency = 1
				p1.CanCollide = false
				p1.CanTouch = false
				p1.CanQuery = false
				p1.Massless = true
				p1.Anchored = false
				p1.CFrame = pivotCF * CFrame.Angles(0, math.pi, 0)
				p1.Parent = modele
			else
				p1 = principal[def.name]
			end
			for _, x in ipairs(p1:GetChildren()) do
				if x:IsA("Motor6D") then
					x:Destroy()
				end
			end
			local m = Instance.new("Motor6D")
			m.Name = def.name
			m.Part0 = p0
			m.Part1 = p1
			m.C0 = p0.CFrame:ToObjectSpace(pivotCF)
			m.C1 = p1.CFrame:ToObjectSpace(pivotCF)
			m.Parent = p1
			nbMoteurs += 1
		end
		for _, e in ipairs(extras) do
			local w = Instance.new("WeldConstraint")
			w.Part0 = principal[e[1]]
			w.Part1 = e[2]
			w.Parent = e[2]
		end
		-- lueur de la gueule
		local glowMarker = modele:FindFirstChild("GLOW_MOUTH", true)
		local glowPos = M2 * v3(data.rig.glow)
		if glowMarker then
			glowMarker:Destroy()
		end
		local lueur = Instance.new("Part")
		lueur.Name = "Lueur"
		lueur.Shape = Enum.PartType.Ball
		lueur.Size = Vector3.new(0.22, 0.22, 0.22)
		lueur.Material = Enum.Material.Neon
		lueur.Color = Color3.fromRGB(255, 96, 36)
		lueur.Transparency = 0.15
		lueur.CanCollide = false
		lueur.CanTouch = false
		lueur.CanQuery = false
		lueur.Massless = true
		lueur.CastShadow = false
		lueur.CFrame = CFrame.new(glowPos)
		lueur.Parent = modele
		local light = Instance.new("PointLight")
		light.Range = 7
		light.Brightness = 1.6
		light.Color = Color3.fromRGB(255, 110, 50)
		light.Shadows = false
		light.Parent = lueur
		local wl = Instance.new("WeldConstraint")
		wl.Part0 = principal.Head
		wl.Part1 = lueur
		wl.Parent = lueur
		-- marqueurs et gabarits de sang
		for _, nom in ipairs({ "REF_A", "REF_B", "REF_C", "REF_D" }) do
			local mk = modele:FindFirstChild(nom, true)
			if mk then
				mk:Destroy()
			end
		end
		preparerEffets(modele, dossier, rapport)
		-- propriétés physiques
		for _, d in ipairs(modele:GetDescendants()) do
			if d:IsA("BasePart") and d ~= hrp then
				d.CanCollide = false
				d.CanTouch = false
				d.Massless = true
				d.Anchored = false
				if d:IsA("MeshPart") then
					pcall(function()
						d.CollisionFidelity = Enum.CollisionFidelity.Box
					end)
				end
			end
		end
		local hum = modele:FindFirstChildOfClass("Humanoid") or Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R15
		hum.AutomaticScalingEnabled = false
		hum.RequiresNeck = false
		hum.BreakJointsOnDeath = false
		hum.HipHeight = data.rig.hrp.hipHeight
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.WalkSpeed = 5.5
		hum.Parent = modele
		hrp.Anchored = false
		pcall(function() -- avec StreamingEnabled, tout le modèle arrive d'un coup chez les clients
			modele.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		end)
		modele.Name = "Monstre"
		modele:SetAttribute("MA_Installe", true)
		CollectionService:AddTag(modele, "Monstre")
		if modele.Parent ~= workspace then
			modele.Parent = workspace
		end
		table.insert(rapport, string.format("rig monté : %d Motor6D (37 pièces + VictimeAncre), %d maillage(s) soudé(s) en plus",
			nbMoteurs, #extras))
		return modele
	end)
	if enreg then
		pcall(function()
			ChangeHistoryService:FinishRecording(enreg, ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
		end)
	end
	if not ok then
		warn("[Monstre] installation impossible : " .. tostring(res))
		return false, tostring(res)
	end
	-- le kit est rangé dans ServerStorage (réinstallation possible)
	if KIT.Parent ~= ServerStorage then
		local ancien = ServerStorage:FindFirstChild(KIT.Name)
		if ancien and ancien ~= KIT then
			ancien:Destroy()
		end
		KIT.Parent = ServerStorage
	end
	table.insert(rapport, "scripts installés : ReplicatedStorage.Monstre, ServerScriptService.MonstreServeur, StarterPlayerScripts.MonstreClient, ServerStorage.MonstreOutils")
	table.insert(rapport, "lancez le test (F5) ; essais : require(game.ServerStorage.MonstreOutils).miseAMort(\"frenesie\") (barre de commande, côté serveur)")
	print("[Monstre] installation terminée :\n  - " .. table.concat(rapport, "\n  - "))
	return true, res, rapport
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">MonstreAnim</string><ProtectedString name="Source"><![CDATA[--[[
	MonstreAnim (ModuleScript, ReplicatedStorage.Monstre) : lecteur d'animations du monstre et de ses victimes.

	Les animations ne passent pas par des AnimationTrack : chaque client calcule la pose (pistes par articulation de
	MonstreDonnees) et écrit Motor6D.Transform à chaque image (RunService.PreSimulation, après l'Animator, donc par-dessus
	les animations du survivant). Rien n'est à publier sur Roblox, et la pose de chaque phase de mise à mort ne dépend que
	de (clip, heure de début sur l'horloge du serveur) : tous les clients voient la même chose au même moment.

	Format d'une piste (MonstreDonnees) : chaîne base64 d'enregistrements little-endian
		u16 temps (ms) ; i16 qx, qy, qz, qw (x 32767) ; puis i16 x, y, z (mm) si la piste a une translation.
	Interpolation : linéaire pour la translation, quaternion normalisé (nlerp) pour la rotation (comme le calcul de la
	réduction des clés, faite hors ligne avec une tolérance de 0,5 degré).
]]

local MonstreAnim = {}

local DONNEES -- table de MonstreDonnees (définie par MonstreAnim.init)
local CLIPS = { monstre = {}, victime = {} } -- clips décodés à la demande

------------------------------------------------------------------------------------------------------------
-- décodage
------------------------------------------------------------------------------------------------------------
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DEC = {}
for i = 1, 64 do
	DEC[string.byte(B64, i)] = i - 1
end

local function b64decode(s)
	local len = #s
	local pad = 0
	if string.sub(s, -2) == "==" then
		pad = 2
	elseif string.sub(s, -1) == "=" then
		pad = 1
	end
	local nbytes = (len // 4) * 3 - pad
	local buf = buffer.create(math.max(nbytes, 0))
	local o = 0
	for i = 1, len, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local x = DEC[a] * 262144 + DEC[b] * 4096 + (DEC[c] or 0) * 64 + (DEC[d] or 0)
		local b1, b2, b3 = x // 65536, (x // 256) % 256, x % 256
		if o < nbytes then
			buffer.writeu8(buf, o, b1)
		end
		if o + 1 < nbytes then
			buffer.writeu8(buf, o + 1, b2)
		end
		if o + 2 < nbytes then
			buffer.writeu8(buf, o + 2, b3)
		end
		o += 3
	end
	return buf, nbytes
end
MonstreAnim._b64decode = b64decode

local function decodeTrack(s, hasT)
	local buf, nbytes = b64decode(s)
	local rec = hasT and 16 or 10
	local n = nbytes // rec
	local T, Q = table.create(n), table.create(n * 4)
	local P = hasT and table.create(n * 3) or nil
	for i = 0, n - 1 do
		local o = i * rec
		T[i + 1] = buffer.readu16(buf, o) / 1000
		local qx, qy = buffer.readi16(buf, o + 2), buffer.readi16(buf, o + 4)
		local qz, qw = buffer.readi16(buf, o + 6), buffer.readi16(buf, o + 8)
		local m = math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw) -- quaternion quantifié : renormalisé
		Q[i * 4 + 1], Q[i * 4 + 2], Q[i * 4 + 3], Q[i * 4 + 4] = qx / m, qy / m, qz / m, qw / m
		if hasT then
			P[i * 3 + 1] = buffer.readi16(buf, o + 10) / 1000
			P[i * 3 + 2] = buffer.readi16(buf, o + 12) / 1000
			P[i * 3 + 3] = buffer.readi16(buf, o + 14) / 1000
		end
	end
	return { T = T, Q = Q, P = P, n = n }
end

function MonstreAnim.init(donnees)
	DONNEES = donnees
	CLIPS = { monstre = {}, victime = {} }
	return MonstreAnim
end

function MonstreAnim.donnees()
	return DONNEES
end

-- clip décodé : {key, name, length, loop, speed, markers, tracks = {nom = piste}}
function MonstreAnim.clip(rig, key)
	local cache = CLIPS[rig]
	local c = cache[key]
	if c then
		return c
	end
	local src = DONNEES[rig][key]
	if not src then
		return nil
	end
	c = {
		key = key,
		name = src.name,
		label = src.label,
		length = src.length,
		loop = src.loop,
		speed = src.speed,
		markers = src.markers or {},
		tracks = {},
	}
	for nom, s in pairs(src.tracks) do
		c.tracks[nom] = decodeTrack(s, src.trans and src.trans[nom] or false)
	end
	cache[key] = c
	return c
end

------------------------------------------------------------------------------------------------------------
-- échantillonnage
------------------------------------------------------------------------------------------------------------
local function findSeg(T, n, t)
	if t <= T[1] then
		return 1, 0
	end
	if t >= T[n] then
		return n, 0
	end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if T[mid] <= t then
			lo = mid
		else
			hi = mid
		end
	end
	return lo, (t - T[lo]) / (T[lo + 1] - T[lo])
end

-- renvoie qx, qy, qz, qw, x, y, z
local function sampleTrack(tr, t)
	local i, u = findSeg(tr.T, tr.n, t)
	local Q = tr.Q
	local a = (i - 1) * 4
	local qx, qy, qz, qw = Q[a + 1], Q[a + 2], Q[a + 3], Q[a + 4]
	local x, y, z = 0, 0, 0
	local P = tr.P
	if P then
		local b = (i - 1) * 3
		x, y, z = P[b + 1], P[b + 2], P[b + 3]
	end
	if u > 0 then
		local c = a + 4
		local rx, ry, rz, rw = Q[c + 1], Q[c + 2], Q[c + 3], Q[c + 4]
		if qx * rx + qy * ry + qz * rz + qw * rw < 0 then
			rx, ry, rz, rw = -rx, -ry, -rz, -rw
		end
		qx, qy, qz, qw = qx + (rx - qx) * u, qy + (ry - qy) * u, qz + (rz - qz) * u, qw + (rw - qw) * u
		local m = math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
		qx, qy, qz, qw = qx / m, qy / m, qz / m, qw / m
		if P then
			local b = i * 3
			x, y, z = x + (P[b + 1] - x) * u, y + (P[b + 2] - y) * u, z + (P[b + 3] - z) * u
		end
	end
	return qx, qy, qz, qw, x, y, z
end
MonstreAnim.sampleTrack = sampleTrack

-- temps local du clip (boucle ou maintien de la dernière pose)
local function clipTime(c, t)
	if c.loop then
		local L = c.length
		return t - math.floor(t / L) * L
	end
	return math.clamp(t, 0, c.length)
end
MonstreAnim.clipTime = clipTime

-- pose d'un clip : {nom = {qx, qy, qz, qw, x, y, z}}
function MonstreAnim.pose(rig, key, t)
	local c = MonstreAnim.clip(rig, key)
	local out = {}
	if not c then
		return out
	end
	local tt = clipTime(c, t)
	for nom, tr in pairs(c.tracks) do
		local qx, qy, qz, qw, x, y, z = sampleTrack(tr, tt)
		out[nom] = { qx, qy, qz, qw, x, y, z }
	end
	return out
end

local function toCFrame(p)
	return CFrame.new(p[5], p[6], p[7], p[1], p[2], p[3], p[4])
end
MonstreAnim.toCFrame = toCFrame

local IDENT = { 0, 0, 0, 1, 0, 0, 0 }

local function blend(a, b, w)
	a = a or IDENT
	b = b or IDENT
	if w >= 1 then
		return b
	elseif w <= 0 then
		return a
	end
	local bx, by, bz, bw = b[1], b[2], b[3], b[4]
	if a[1] * bx + a[2] * by + a[3] * bz + a[4] * bw < 0 then
		bx, by, bz, bw = -bx, -by, -bz, -bw
	end
	local qx, qy, qz, qw = a[1] + (bx - a[1]) * w, a[2] + (by - a[2]) * w, a[3] + (bz - a[3]) * w, a[4] + (bw - a[4]) * w
	local m = math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
	return { qx / m, qy / m, qz / m, qw / m, a[5] + (b[5] - a[5]) * w, a[6] + (b[6] - a[6]) * w, a[7] + (b[7] - a[7]) * w }
end
MonstreAnim.blend = blend

------------------------------------------------------------------------------------------------------------
-- lecteur : deux couches (base = déplacement, action = gestes et mises à mort), fondus enchaînés
------------------------------------------------------------------------------------------------------------
local Lecteur = {}
Lecteur.__index = Lecteur

-- moteurs : {nom de piste = Motor6D}
function MonstreAnim.lecteur(rig, moteurs)
	return setmetatable({
		rig = rig,
		moteurs = moteurs,
		couches = { base = {}, action = {} },
		poidsAction = 0,
		cibleAction = 0,
		fonduAction = 0.2,
	}, Lecteur)
end

-- moteurs d'un modèle : monstre = Motor6D nommés comme les pièces ; victime = clé = nom de la Part1
function MonstreAnim.moteurs(modele, rig)
	local out = {}
	for _, d in ipairs(modele:GetDescendants()) do
		if d:IsA("Motor6D") then
			if rig == "monstre" then
				out[d.Name] = d
			elseif d.Part1 then
				out[d.Part1.Name] = d
			end
		end
	end
	return out
end

-- joue un clip sur une couche. opts : debut (horloge de référence), horloge (fonction), vitesse, fondu, decalage
function Lecteur:jouer(couche, key, opts)
	opts = opts or {}
	local c = MonstreAnim.clip(self.rig, key)
	if not c then
		return nil
	end
	local L = self.couches[couche]
	local cur = L.cur
	if cur and cur.key == key and not opts.relancer then
		cur.vitesse = opts.vitesse or cur.vitesse
		return cur
	end
	local horloge = opts.horloge or os.clock
	local now = horloge()
	local lec = {
		key = key,
		clip = c,
		horloge = horloge,
		debut = opts.debut or now,
		vitesse = opts.vitesse or 1,
		tAcc = opts.decalage or 0, -- temps accumulé (vitesse variable) pour la couche de base
		dernier = now,
		tPrec = nil,
	}
	if cur then
		L.prev = cur
		L.fonduDebut = now
		L.fondu = opts.fondu or 0.2
		L.horlogeFondu = horloge
	end
	L.cur = lec
	if couche == "action" then
		self.cibleAction = 1
		self.fonduAction = opts.fondu or 0.2
	end
	return lec
end

function Lecteur:arreterAction(fondu)
	self.cibleAction = 0
	self.fonduAction = fondu or 0.25
end

-- temps courant d'une lecture (avec vitesse) ; la couche de base accumule (vitesse qui change sans saut)
local function tempsLecture(lec, accumule)
	local now = lec.horloge()
	if accumule then
		lec.tAcc += (now - lec.dernier) * lec.vitesse
		lec.dernier = now
		return lec.tAcc
	end
	return (now - lec.debut) * lec.vitesse
end
MonstreAnim._tempsLecture = tempsLecture

local function evalLecture(self, lec, t)
	return MonstreAnim.pose(self.rig, lec.key, t)
end

-- marqueurs franchis entre deux instants (boucles comprises) : {instant du marqueur, nom, valeur, instant courant}
local function marqueursEntre(c, t0, t1, out)
	if not c.markers or #c.markers == 0 or t1 <= t0 then
		return
	end
	if not c.loop then
		for _, m in ipairs(c.markers) do
			if m[1] > t0 and m[1] <= t1 then
				table.insert(out, { m[1], m[2], m[3], t1 })
			end
		end
		return
	end
	local L = c.length
	local k0 = math.floor(t0 / L)
	local k1 = math.floor(t1 / L)
	for k = math.max(k0, k1 - 3), k1 do
		for _, m in ipairs(c.markers) do
			local tm = k * L + m[1]
			if tm > t0 and tm <= t1 then
				table.insert(out, { tm, m[2], m[3], t1 })
			end
		end
	end
end
MonstreAnim.marqueursEntre = marqueursEntre

-- calcule la pose, écrit les Transform ; renvoie les marqueurs franchis (déplacement et action courante)
function Lecteur:etape(dt)
	local poses = {}
	local base = self.couches.base
	local evts = {}
	if base.cur then
		local t = tempsLecture(base.cur, true)
		local p = evalLecture(self, base.cur, t)
		if base.cur.tPrec ~= nil then
			marqueursEntre(base.cur.clip, base.cur.tPrec, t, evts)
		end
		base.cur.tPrec = t
		if base.prev then
			local w = math.clamp((base.horlogeFondu() - base.fonduDebut) / math.max(base.fondu, 1e-3), 0, 1)
			if w >= 1 then
				base.prev = nil
			else
				local tp = tempsLecture(base.prev, true)
				local pp = evalLecture(self, base.prev, tp)
				for nom, _ in pairs(self.moteurs) do
					p[nom] = blend(pp[nom], p[nom], w)
				end
			end
		end
		poses = p
	end
	-- couche d'action
	local A = self.couches.action
	local step = (dt or 1 / 60) / math.max(self.fonduAction, 1e-3)
	if self.cibleAction > self.poidsAction then
		self.poidsAction = math.min(self.cibleAction, self.poidsAction + step)
	elseif self.cibleAction < self.poidsAction then
		self.poidsAction = math.max(self.cibleAction, self.poidsAction - step)
	end
	if A.cur and self.poidsAction > 0 then
		local lec = A.cur
		local t = tempsLecture(lec, false)
		local pa = evalLecture(self, lec, t)
		if A.prev then
			local w = math.clamp((A.horlogeFondu() - A.fonduDebut) / math.max(A.fondu, 1e-3), 0, 1)
			if w >= 1 then
				A.prev = nil
			else
				local tp = tempsLecture(A.prev, false)
				local pp = evalLecture(self, A.prev, tp)
				for nom, _ in pairs(self.moteurs) do
					pa[nom] = blend(pp[nom], pa[nom], w)
				end
			end
		end
		for nom, _ in pairs(self.moteurs) do
			poses[nom] = blend(poses[nom], pa[nom], self.poidsAction)
		end
		if lec.tPrec ~= nil then
			marqueursEntre(lec.clip, lec.tPrec, t, evts)
		elseif t >= 0 then
			marqueursEntre(lec.clip, -1e-6, t, evts)
		end
		lec.tPrec = t
		lec.fini = (not lec.clip.loop) and t >= lec.clip.length
	elseif A.cur and self.cibleAction == 0 and self.poidsAction <= 0 then
		A.cur = nil
		A.prev = nil
	end
	for nom, m in pairs(self.moteurs) do
		local p = poses[nom]
		m.Transform = p and toCFrame(p) or CFrame.identity
	end
	return evts
end

function Lecteur:action()
	return self.couches.action.cur
end

------------------------------------------------------------------------------------------------------------
-- cinématique directe (serveur : cadavre posé, points du corps pour le sang)
------------------------------------------------------------------------------------------------------------

-- CFrame monde de chaque pièce d'un modèle pour une pose donnée (racine : la pièce sans Motor6D parent).
-- pose : {nom de piste = {qx, qy, qz, qw, x, y, z}} ; cle : "monstre" (nom du Motor6D) ou "victime" (nom de la Part1)
function MonstreAnim.cinematique(modele, rig, pose, racineCF)
	local moteurs = MonstreAnim.moteurs(modele, rig)
	local parPart1 = {}
	for nom, m in pairs(moteurs) do
		if m.Part0 and m.Part1 then
			parPart1[m.Part1] = { m = m, nom = nom }
		end
	end
	local racine = modele:FindFirstChild("HumanoidRootPart")
	local out = {}
	if racine then
		out[racine] = racineCF or racine.CFrame
	end
	local function cfDe(part)
		if out[part] then
			return out[part]
		end
		local e = parPart1[part]
		if not e then
			out[part] = part.CFrame
			return out[part]
		end
		local p0 = cfDe(e.m.Part0)
		local p = pose[e.nom]
		local tr = p and toCFrame(p) or CFrame.identity
		out[part] = p0 * e.m.C0 * tr * e.m.C1:Inverse()
		return out[part]
	end
	for _, d in ipairs(modele:GetDescendants()) do
		if d:IsA("BasePart") then
			cfDe(d)
		end
	end
	return out
end

-- CFrame monde de la pièce VictimeAncre (où est soudé le HumanoidRootPart de la victime) au temps t d'un clip
function MonstreAnim.ancre(monstre, key, t)
	local hrp = monstre:FindFirstChild("HumanoidRootPart")
	local m = monstre:FindFirstChild("VictimeAncre", true)
	if not (hrp and m and m:IsA("Motor6D")) then
		return nil
	end
	local p = MonstreAnim.pose("monstre", key, t).VictimeAncre
	local tr = p and toCFrame(p) or CFrame.identity
	return hrp.CFrame * m.C0 * tr * m.C1:Inverse()
end

return MonstreAnim
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">MonstreConfig</string><ProtectedString name="Source"><![CDATA[--[[
	MonstreConfig (ModuleScript, ReplicatedStorage.Monstre) : réglages du monstre. Modifiez librement les valeurs ;
	le serveur et les clients relisent ce module au lancement du jeu.
]]

return {
	-- déplacement (studs/s). Les animations de marche et de course sont accélérées ou ralenties dans la même
	-- proportion (pieds plantés : marche 5,5 et course 20 sont les vitesses des clips)
	VITESSE = {
		marche = 5.5,
		course = 20,
		trainer = 4.2, -- traîner une victime (clip calé sur 4,2)
		trainer_vite = 8, -- la tirer hors de la pièce (clip calé sur 8)
	},

	-- perception
	DETECTION = {
		vue = 70, -- distance de vue (studs), avec ligne de vue dégagée
		angle_vue = 140, -- champ de vision (degrés) ; derrière lui il n'entend que les joueurs qui courent
		ouie = 26, -- entend un joueur qui court (vitesse > 10) à cette distance, même sans le voir
		oubli = 8, -- secondes sans voir sa cible avant d'abandonner la poursuite
		hurle_a_la_vue = true, -- hurle quand il repère une nouvelle cible
	},

	-- attaque : distance à laquelle une mise à mort se déclenche, temps entre deux mises à mort
	PORTEE_ATTAQUE = 5.5,
	REPOS_APRES_MISE_A_MORT = 6,

	-- mises à mort disponibles et poids du tirage (0 = désactivée)
	MISES_A_MORT = {
		morsure_cou = 1,
		morsure_repetee = 1,
		devoration = 1,
		attaque_ventre = 1,
		trainee = 1,
		extraction = 1,
		frenesie = 1,
		contamination = 1,
	},

	-- traînées : où aller (parties étiquetées dans la place avec CollectionService), distance sinon
	TRAINER = {
		etiquette_taniere = "MonstreTaniere", -- dévoration : un coin sombre
		etiquette_sortie = "MonstreSortie", -- traînée : une porte, la sortie de la pièce
		distance_max = 45, -- studs parcourus au plus
		distance_sans_cible = 26, -- sans partie étiquetée : distance parcourue (en s'éloignant des joueurs)
		duree_repas = 7, -- secondes de dévoration
	},

	-- patrouille : parties étiquetées « MonstrePatrouille », sinon des points au hasard autour du départ
	PATROUILLE = {
		etiquette = "MonstrePatrouille",
		rayon = 60,
		pause_min = 2,
		pause_max = 6,
		flairer = 0.35, -- probabilité de flairer à chaque pause
	},

	-- victimes possibles : les personnages des joueurs, et les modèles étiquetés « Survivant » (essais dans Studio)
	ETIQUETTE_VICTIME = "Survivant",

	-- sang et gore
	SANG = {
		actif = true,
		decalques = true, -- flaques, éclaboussures et traînées au sol
		particules = true,
		ecran = true, -- sang sur l'écran de la victime
		duree_decalques = 90, -- secondes avant disparition
		duree_cadavre = 60, -- secondes avant de retirer le cadavre (0 = jamais)
		quantite = 1, -- multiplie le nombre d'éclaboussures
	},

	-- caméra de la victime pendant sa mise à mort
	CAMERA = {
		active = true,
		tremblement = 1, -- force des tremblements
		champ = 60, -- champ de vision (degrés) des plans cinématiques
	},

	-- infection (mise à mort « contamination ») : la victime survit, les symptômes commencent après « delai »
	INFECTION = {
		delai = 4,
		duree = 60, -- montée des symptômes (secondes)
		vitesse_min = 0.6, -- vitesse de marche au plus fort (fraction)
		degats_par_seconde = 0, -- 0 : elle reste en vie
		issue = "rien", -- "rien" (symptômes jusqu'à la mort du personnage) ou "mort" (meurt à la fin de « duree »)
		teinte_peau = Color3.fromRGB(150, 165, 140), -- multiplie la couleur de la tenue et de la peau
	},

	-- sons : remplissez les identifiants (rbxassetid://...) après avoir importé les fichiers de monstre/roblox/sons
	-- dans le Gestionnaire de ressources ; un son sans identifiant est ignoré
	SONS = {
		volume = 1,
		grognement = "",
		hurlement = "",
		hurlement_court = "",
		reniflement = "",
		souffle = "",
		pas_lourd = "",
		saisie = "",
		morsure = "",
		dechirure = "",
		craquement = "",
		mastication = "",
		impact = "",
		chute_corps = "",
		trainer = "",
		cri_victime = "",
		eclaboussure = "",
		battement = "",
		toux = "",
		acouphene = "",
	},

	-- vie du monstre (il ne meurt pas par défaut)
	VIE = math.huge,
	-- affiche des informations dans la sortie (Output)
	DEBUG = false,
}
